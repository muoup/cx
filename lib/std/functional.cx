public:

comptime expr(T) tap(@type T, expr(T) value, @fn func(expr(T&)) -> expr(void)) =>
    emit .{
        T val = value;
        func(val);
        yield move val;
    };

comptime expr(T) inspect(@type T, expr(T) value, @fn func(expr(const T&)) -> expr(void)) =>
    emit .{
        T val = value;
        func(val);
        yield move val;
    };
