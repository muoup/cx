public:

comptime expr T tap<T, U>(expr T value, expr(T&) U func) {
    return emit .{
        T val = value;
        func(val);
        yield move val;
    };
}

comptime expr T inspect<T, U>(expr T value, expr(T&) U func) {
    return emit .{
        T val = value;
        func(val);
        yield move val;
    };
}
