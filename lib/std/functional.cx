public:

comptime expr T tap<T>(expr T value, expr(T&) void func) {
    return emit .{
        T val = value;
        func(val);
        yield move val;
    };
}

comptime expr T inspect<T>(expr T value, expr(const T&) void func) {
    return emit .{
        T val = value;
        func(val);
        yield move val;
    };
}
