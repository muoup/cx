import std::io;

#include <stdlib.h>

public:

enum union opt<T> : @copy_traits(T) {
    none :: void,
    some :: T
};

bool opt<T>::is_some<T>(*this) {
    return this is opt::some<T>(_);
}

opt<U> opt<T>::map<T, U>(*this, U (*func)(T)) {
    if (this is opt::some<T>(value)) {
        return opt::some<U>(func(value));
    }

    return opt::none<U>();
}

T opt<T>::unwrap_or<T>(*this, T otherwise) {
    if (this is opt::some<T>(value)) {
        return value;
    }

    return move otherwise;
}

T opt<T>::unwrap<T>(this) {
    match (move this) {
        opt::some<T>(val) => return move val;
        opt::none<T>() => {
            std::io::println("Error: called `opt::unwrap()` on a `None` value");
            exit(1);
        }
    }
}
