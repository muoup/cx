import std::io;

extern "C":

#include <stdlib.h>

public:

comptime @type opt(@type T) =>
    enum union : @copy_traits(T) {
        none :: void,
        some :: T
    };

bool opt::is_some(@type T, opt(T)& this) {
    return this is some(_);
}

bool opt::is_none(@type T, opt(T)& this) {
    return this is none();
}

opt(U) opt::map(@type T, @type U, opt(T) this, @fn func(T) -> U) {
    match (move this) {
        some(auto value) => return opt(U)::some(func(move value));
        none() => return opt(U)::none();
    }
}

T opt::unwrap(@type T, opt(T) this) {
    match (move this) {
        some(auto val) => return move val;
        none() => {
            std::io::println("Error: called `opt::unwrap()` on a `None` value");
            exit(1);
        }
    }
}

T opt::unwrap_or(@type T, opt(T) this, T default_value) {
    match (move this) {
        some(auto val) => return move val;
        none() => return default_value;
    }
}

comptime expr(T) opt::unwrap_or_else(@type T, expr(opt(T)) self, expr(unreachable) on_none) =>
    emit match (self) {
        some(auto value) => yield move value;
        none() => on_none;
    };

comptime expr(T) opt::try(@type T, expr(opt(T)) self) =>
    emit match (self) {
        some(auto value) => yield move value;
        none() => return _::none();
    };

comptime expr(T) opt::try_or(@type T, expr(opt(T)) self, expr(void) on_none) =>
    emit match (self) {
        some(auto value) => yield move value;
        none() => {
            on_none;
            return _::none();
        }
    };
