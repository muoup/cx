import std::allocation as std;

#include <stdlib.h>
#include <string.h>

public:

comptime type box(type T, std::allocator A = std::heap_allocator) = @strong std::allocation(A);

box(T, .A = A) box::new(comptime type T = _, comptime std::allocator A = std::heap_allocator, T value) 
where
    pre: (!@type.is_unsafe_move(T))
{
    @unsafe {
        auto b = std::allocate(A, sizeof(T));
        memcpy(b.data, &value, sizeof(T));
        @leak(value);
        return (box(T, .A = A)) move b;
    };
}

const T& box::deref(const box(_: T)& this) {
    return *((const T*) this.data);
}

T& box::deref_mut(box(_: T)& this) {
    return *((T*) this.data);
}

T* box::leak(box(_: T) this) {
    T* ptr = this.data;
    @leak(this);
    return ptr;
}

void box::drop_with(box(_: T, .A = _: A) this, fn* drop(T) -> void) {
    @unsafe {
        T value = @adopt(this |> box::deref_mut());
        drop(move value);
    };

    ((std::allocation(A)) move this) |> std::deallocate();
}

void box::drop(box(_: T, .A = _: A) this) 
where
    pre: (!@type.is_nodrop(T))
{
    ((std::allocation(A)) move this) |> std::deallocate();
}
