import std::{optional, string, memory::allocation, panic} as std;

extern "C":

#include <stdio.h>
#include <limits.h>
#include <string.h>

public:

struct file : @nodrop {
    FILE* handle;
};

std::opt(file) file::open(const char* path, const char* mode) {
    FILE* handle = fopen(path, mode);

    return std::opt::if_then(emit handle != NULL, emit (file) { .handle = handle });
}

void file::close(file this) {
    fclose(this.handle);
    @leak(this);
}

void file::write(file& this, const char* data) {
    if (this.handle != NULL) {
        fputs(data, this.handle);
    }
}

void file::write_line(file& this, const char* data) {
    if (this.handle != NULL) {
        fputs(data, this.handle);
        fputc('\n', this.handle);
    }
}

void file::flush(file& this) {
    if (this.handle != NULL) {
        fflush(this.handle);
    }
}

std::opt(usize) file::read_line(file& this, char* buffer, usize buffer_size) {
    if (this.handle == NULL || buffer_size < 2 || buffer_size > INT_MAX) return _::none();
    if (fgets(buffer, (int) buffer_size, this.handle) == NULL) return _::none();
    return _::some((usize) strlen(buffer));
}

std::opt(usize) file::read(file& this, char* buffer, usize buffer_size) {
    if (this.handle == NULL) return _::none();
    if (buffer_size == 0) return _::some((usize) 0);
    usize received = fread(buffer, 1, buffer_size, this.handle);
    if (ferror(this.handle)) return _::none();
    return _::some(received);
}

std::string(.A = A) file::read_to_string(comptime std::allocator A = std::heap_allocator, file& this) {
    auto text = std::string::new(.A = A);
    int byte;
    while ((byte = fgetc(this.handle)) != EOF) {
        std::string::append_byte(text, (u8) byte);
    }
    if (ferror(this.handle)) {
        std::string::drop(move text);
        std::panic("Failed to read file");
    }
    return move text;
}
