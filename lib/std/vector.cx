import std::optional;

extern "C":
#include <stdlib.h>
#include <string.h>

public:

comptime @type vector(comptime @type T) =>
    struct : @nodrop {
        T* data;
        usize length;
        usize capacity;
    };

vector(T) vector::new(comptime @type T) {
    return (vector(T)) {
        .data = malloc(4 * sizeof(T)),
        .length = 0,
        .capacity = 4
    };
}

void vector::drop(comptime @type T = _, vector(T) this) {
    @unsafe {
        free(this.data);
        @leak(this);
    };
}

void vector::drop_with(comptime @type T = _, vector(T) this, @fn destructor(T) -> void) {
    @unsafe {
        for (u64 i = 0; i < this.length; i++) {
            T value = @adopt(this.data[i]);
            destructor(move value);
        }

        free(this.data);
        @leak(this);
    };
}

vector(T) vector::with_capacity(comptime @type T, usize capacity) {
    return (vector(T)) {
        .data = malloc(capacity * sizeof(T)),
        .length = 0,
        .capacity = capacity
    };
}

void vector::push(comptime @type T = _, vector(T)& this, T object) {
    if (this.length == this.capacity) {
        this.capacity = this.capacity * 2 + 1;
        this.data = realloc(this.data, this.capacity * sizeof(T));
    }

    this.data[this.length] = move object;
    this.length++;
}

std::optional::opt(T) vector::pop(comptime @type T = _, vector(T)& this) {
    if (this.length == 0) return std::optional::opt(T)::none();

    T buffer;
    T* data_ptr = &data[this.length - 1];
    memcpy(&buffer, data_ptr, sizeof(T));
 
    this.length--;
    return move buffer;
}

std::optional::opt(T&) vector::at(comptime @type T = _, vector(T)& this, usize index) {
    if (index >= this.length) {
        return std::optional::opt(T&)::none();
    }

    return std::optional::opt(T&)::some(this.data[index]);
}