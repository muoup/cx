import std::optional;
import std::io;
import std::span as std;

extern "C":

#include <stdlib.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

public:

struct string : @nodrop {
    char* data;
    u64 length;
    u64 capacity;
};

string string::new() {
    std::optional::opt<string> s = string::try_new_string();
    
    match (move s) {
        std::optional::opt::some<string>(val) => return move val;
        std::optional::opt::none<string>(_) => {
            std::io::println("Failed to allocate memory for string");
            @unsafe(exit(1));
        }
    }
}

string string::clone(const string& this) {
    string result = string::new();
    result |> string::append(this |> string::as_str());
    return move result;
}

string string::from_str(const _str& s) {
    string result = string::new();
    result |> string::append(s);
    return move result;
}

string string::from_span(const std::span<const char>& s) {
    string result = string::new();
    result |> string::append(s |> std::span::as_str());
    return move result;
}

std::optional::opt<string> string::try_new_string() {
    @unsafe {
        void* base_buffer = malloc(16);

        if (base_buffer == NULL) {
            return std::optional::opt::none<string>();
        }
        
        string s = (string) {
            .data = base_buffer,
            .length = 0,
            .capacity = 16
        };
        *s.data = '\0';
    
        return std::optional::opt::some<string>(move s);
    };
}

void string::append(string& this, const _str& s) {
    u64 str_length = strlen(s);

    while (this.length + str_length + 1 >= this.capacity) {
        this |> string::_realloc();
    }

    memcpy(this.data + this.length, s, str_length);
    this.length = str_length + this.length;
    this.data[this.length] = 0;
}

void string::append_char(string& this, char c) {
    if (this.length + 1 >= this.capacity) {
        this |> string::_realloc();
    }

    this.data[this.length++] = c;
    this.data[this.length] = 0;
}

void string::drop(string this) {
    @unsafe {
        free(this.data);
        @leak(this);
    };
}

_str& string::as_str(string& this) {
    // SAFETY: We ensure via our API that our internal const char* is a valid c-string with null-termination,
    // so this cast is safe as long as the caller does not mutate the string data through the returned reference.
    return @unsafe((_str&) this.data);
}

usize string::str_length(const _str& this) {
    return strlen(this);
}

string string::substring(const string& this, usize start, usize end) {
    if (start > end || end > this.length) {
        std::io::println("Invalid substring range");
        @unsafe(exit(1));
    }

    string result = string::new();
    for (usize i = start; i < end; i++) {
        result |> string::append_char(this.data[i]);
    }
    return move result;
}

string str::substring(const _str& this, usize start, usize end) {
    if (start > end || end > strlen(this)) {
        std::io::println("Invalid substring range");
        @unsafe(exit(1));
    }

    string result = string::new();
    for (usize i = start; i < end; i++) {
        result |> string::append_char(this[i]);
    }
    return move result;
}

bool string::equals(const string& this, const string& other) {
    if (this.length != other.length) {
        return false;
    }
    return strcmp(this.data, other.data) == 0;
}

bool str::equals(const _str& this, const _str& other) {
    return strcmp(this, other) == 0;
}

private:

void string::_realloc(string& this) {
    this.capacity = this.capacity * 2;
    this.data = realloc(this.data, this.capacity);
}