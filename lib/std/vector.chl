import std::{allocation, span, optional, panic, memory} as std;
//import std::{allocation, panic, memory} as std;

extern "C":

#include <stdlib.h>
#include <string.h>

comptime usize initialization_size = 4;

public:

comptime bool valid_vector_inner(comptime type T) => !@type.is_reference(T) && !@type.is_const(T);

comptime type vector(comptime type T, comptime std::allocator A = std::heap_allocator)
where
    pre: (@unsafe(valid_vector_inner(T)))
    => struct : @nodrop {
        std::allocation(A) alloc;
        usize length;
        usize capacity;
    };

vector(T, .A = A) vector::new(comptime type T, comptime std::allocator A = std::heap_allocator) {
    return {
        .alloc = std::allocate(A, initialization_size * sizeof(T)),
        .length = 0,
        .capacity = initialization_size,
    };
}

vector(T, .A = A) vector::with_capacity(comptime type T, comptime std::allocator A = std::heap_allocator, usize capacity) {
    return {
        .alloc = std::allocate(A, capacity * sizeof(T)),
        .length = 0,
        .capacity = capacity
    };
}

vector(T, .A = A) vector::from_data(comptime type T, std::allocation(_: A) alloc, usize length)
    => {
        .alloc = move alloc,
        .length = length,
        .capacity = length
    };

void vector::drop(vector(_: T) this)
where
    pre: (!@type.is_nodrop(T))
{
    @unpack(move this) {
        alloc: alloc
    };

    move alloc |> std::deallocate();
}

void vector::drop_with(vector(_: T, .A = _) this, comptime fn destructor(^T) -> ^void) {
    for (usize i = 0; i < this.length; i++) {
        T value = @adopt(this |> vector::at(i));
        move value |> destructor();
    }

    @unpack(move this) {
        alloc: alloc
    };

    move alloc |> std::deallocate();
}

//usize vector::length(vector(_)& this) => this.length;

void vector::push(vector(_: T, .A = _)& this, T object) {
    try_realloc(this);
    memcpy((T*) this.alloc.data + this.length++, &object, sizeof(T));
    @leak(object);
}

std::opt(T) vector::pop(vector(_: T, .A = _)& this) {
    if (this.length == 0) return _::none();

    // This is a bit sketchy but because we are moving into an optional, this should always
    // incur a copy, so the lifetimes check out here.
    T buffer = @adopt(((T*) this.alloc.data)[--this.length]);
    return _::some(move buffer);
}

vector(U, A) vector::reinterpret(comptime type U, vector(_, .A = _: A) this) {
    @unpack(move this) {
        data: data,
        length: length,
        capacity: capacity
    };
    
    return (vector(U)) {
        .data = data,
        .length = length,
        .capacity = capacity
    };
}

std::opt(T&) vector::get(comptime type T = _, vector(T)& this, usize index) {
    if (index >= this.length) {
        return _::none();
    }

    return _::some(((T*) this.alloc.data)[index]);
}

T& vector::at(vector(_: T, .A = _)& this, usize index) {
    // REVIEW: It would be nicer if this could just be a vector::get + an expect, but that doesn't current seem possible
    // due to reference collapse rules. We can't seem to consistently unwrap an opt(T&)

    if (index >= this.length) {
        std::panic("Attempted to index out of vector bounds");
    }

    return ((T*) this.alloc.data)[index];
}

std::span(T) vector::span(vector(_: T, .A = _)& this)
    => std::span::new(this.data, this.length);

vector(@type.unqualify(T)) vector::from_span(std::span(_: T) this) 
where
    pre: (!@type.is_unsafe_move(T))
{
    const usize length = this |> std::span::length();
    auto vector = vector::with_capacity(@type.unqualify(T), length);
    
    vector.length = length;
    memcpy(vector.data, this.data, sizeof(T) * length);
    return move vector;
}

void force_grow(vector(_: T, .A = _: A)& this) {
    this.capacity *= 2;
    std::reallocate_inplace(A, this.alloc, this.capacity * sizeof(T));
}

private:

void try_realloc(vector(_: T, .A = _: A)& this) {
    if (this.length < this.capacity) return;
    this |> force_grow();
}