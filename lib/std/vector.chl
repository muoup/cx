//import std::{allocation, span, optional, panic, memory} as std;
import std::{allocation, panic, memory} as std;

extern "C":

#include <stdlib.h>
#include <string.h>

comptime usize initialization_size = 4;

public:

comptime bool valid_vector_inner(comptime type T) => !@type.is_reference(T) && !@type.is_const(T);

comptime type vector(comptime type T, comptime std::allocator A)
where
    pre: (@unsafe(valid_vector_inner(T)))
    => struct : @nodrop {
        std::allocation(A) alloc;
        usize length;
        usize capacity;
    };

vector(T, A) vector::new(comptime type T, comptime std::allocator A = std::heap_allocator) {
    return {
        .alloc = std::allocate(A, initialization_size * sizeof(T)),
        .length = 0,
        .capacity = initialization_size,
    };
}

vector(T) vector::with_capacity(comptime type T, comptime std::allocator A = std::heap_allocator, usize capacity) {
    return (vector(T, A)) {
        .data = std::allocate(A, capacity * sizeof(T)),
        .length = 0,
        .capacity = capacity
    };
}

vector(T) vector::from_data(comptime type T = _, std::allocation(_) data, usize length) {
    return (vector(T)) {
        .data = data,
        .length = length,
        .capacity = length
    };
}

void vector::drop(comptime type T = _, comptime std::allocator A = _, vector(T, A) this)
where
    pre: (!@type.is_nodrop(T))
{
    @unpack(move this) {
        alloc: alloc
    };

    move alloc |> std::deallocate();
}

void vector::drop_with(comptime type T = _, vector(T, _) this, comptime fn destructor(^T) -> ^void) {
    auto owned = this;
    
    for (usize i = 0; i < owned.length; i++) {
        T value = @adopt(owned.data[i]);
        move value |> destructor();
    }

    @unpack(move this) {
        data: data
    };

    move data |> std::deallocate();
}

//usize vector::length(vector(_)& this) => this.length;

void vector::push(
    comptime type T = _, comptime std::allocator A = _, 
    vector(T, A)& this, 
    T object
) {
    try_realloc(this);
    memcpy((T*) this.alloc.data + this.length++, &object, sizeof(T));
    @leak(object);
}

