import std::optional as std;
import std::span as std;
import std::io as std;

import std::net::address as std::net;

extern "C":

i32 socket(int domain, int type, int protocol);
i32 bind(int sockfd, const void* addr, u32 addrlen);
i32 listen(int sockfd, int backlog);
i64 sendto(int sockfd, const void* buf, usize len, int flags, const void* dest_addr, u32 addrlen);
i64 recvfrom(int sockfd, void* buf, usize len, int flags, void* src_addr, u32* addrlen);
i32 close(int fd);

enum {
    LINUX_SOCK_DGRAM = 2,
};

public:

struct datagram {
    u64 length;
    std::net::endpoint source;
};

struct udp_socket : @nodrop {
    i32 fd;
};

std::opt<udp_socket> udp_socket::open() {
    i32 fd = socket(std::net::LINUX_AF_INET, LINUX_SOCK_DGRAM, 0);

    if (fd < 0) {
        return std::opt::none<udp_socket>();
    }

    return std::opt::some<udp_socket>((udp_socket) { .fd = fd });
}

std::opt<void> udp_socket::bind(udp_socket& this, std::net::endpoint addr) {
    if (bind(this.fd, &addr.address, addr.length) < 0) {
        return std::opt::none();
    }

    return std::opt::some();
}

std::opt<u64> udp_socket::send_to(udp_socket& this, const std::span<const u8> buffer, std::net::endpoint& remote) {
    i64 sent = sendto(this.fd, buffer.data, buffer.length, 0, &remote.address, remote.length);

    if (sent < 0) {
        return std::opt::none<u64>();
    }

    return std::opt::some<u64>((u64) sent);
}

std::opt<datagram> udp_socket::recv_from(udp_socket& this, void* buffer, u64 capacity) {
    std::net::endpoint source;
    source.length = (u32) sizeof(std::net::sockaddr_in);

    i64 received = recvfrom(this.fd, buffer, capacity, 0, &source.address, &source.length);

    if (received < 0) {
        return std::opt::none<datagram>();
    }

    return std::opt::some<datagram>((datagram) {
        .length = (u64) received,
        .source = source
    });
}

void udp_socket::close(udp_socket this) {
    close(this.fd);
    @leak(this);
}
