import std::optional as std;
import std::span as std;

import std::net::address as std::net;

extern "C":

i32 socket(int domain, int type, int protocol);
i32 setsockopt(int socket, int level, int option_name, const void* option_value, u32 option_len);
i32 bind(int sockfd, const void* addr, u32 addrlen);
i32 listen(int sockfd, int backlog);
i32 accept(int sockfd, void* addr, u32* addrlen);
i64 read(int fd, void* buffer, usize length);
i64 write(int fd, const void* buffer, usize length);
i32 close(int fd);

enum {
    LINUX_AF_INET = 2,
    LINUX_SOCK_STREAM = 1,
    LINUX_SOL_SOCKET = 1,
    LINUX_SO_REUSEADDR = 2,
};

public:

struct tcp_listener : @nodrop {
    i32 fd;
};

struct tcp_stream : @nodrop {
    i32 fd;
};

std::opt(tcp_listener) tcp_listener::open() {
    i32 fd = socket(LINUX_AF_INET, LINUX_SOCK_STREAM, 0);

    if (fd < 0) {
        return _::none();
    }

    int enabled = 1;
    setsockopt(fd, LINUX_SOL_SOCKET, LINUX_SO_REUSEADDR, &enabled, (u32) sizeof(int));

    return _::some((tcp_listener) { .fd = fd });
}

std::opt(void) tcp_listener::bind(tcp_listener& this, std::net::endpoint addr) {
    if (bind(this.fd, &addr.address, addr.length) < 0) {
        return _::none();
    }

    return _::some();
}

std::opt(void) tcp_listener::listen(tcp_listener& this, int backlog) {
    if (listen(this.fd, backlog) < 0) {
        return _::none();
    }

    return _::some();
}

std::opt(tcp_stream) tcp_listener::accept(tcp_listener& this) {
    std::net::endpoint remote;
    remote.length = (u32) sizeof(std::net::sockaddr_in);

    i32 fd = accept(this.fd, &remote.address, &remote.length);

    if (fd < 0) {
        return _::none();
    }

    return _::some((tcp_stream) { .fd = fd });
}

void tcp_listener::close(tcp_listener this) {
    close(this.fd);
    @leak(this);
}

std::opt(u64) tcp_stream::read(tcp_stream& this, void* buffer, u64 capacity) {
    i64 received = read(this.fd, buffer, capacity);

    if (received < 0) {
        return _::none();
    }

    return _::some((u64) received);
}

std::opt(u64) tcp_stream::write(tcp_stream& this, const std::span(const u8) buffer) {
    i64 sent = write(this.fd, buffer.data, buffer.length);

    if (sent < 0) {
        return _::none();
    }

    return _::some((u64) sent);
}

void tcp_stream::close(tcp_stream this) {
    close(this.fd);
    @leak(this);
}
