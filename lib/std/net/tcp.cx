import std::{span, optional} as std;
import std::net::address as std::net;

extern "C":

// Not enough C parity for these headers yet:
#include <sys/socket.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <fcntl.h>

public:

struct tcp_listener : @nodrop {
    i32 fd;
};

struct tcp_stream : @nodrop {
    i32 fd;
};

std::opt(tcp_listener) tcp_listener::open() {
    i32 fd = socket(AF_INET, SOCK_STREAM, 0);

    if (fd < 0) {
        return _::none();
    }

    int enabled = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &enabled, (u32) sizeof(int));

    return _::some((tcp_listener) { .fd = fd });
}

void tcp_listener::close(tcp_listener this) {
    close(this.fd);
    @leak(this);
}

std::opt(void) tcp_listener::bind(tcp_listener& this, std::net::endpoint addr) {
    if (bind(this.fd, (sockaddr*) &addr.address, addr.length) < 0) {
        return _::none();
    }

    return _::some();
}

std::opt(void) tcp_listener::listen(tcp_listener& this, int backlog) {
    if (listen(this.fd, backlog) < 0) {
        return _::none();
    }

    return _::some();
}

std::opt(void) tcp_listener::set_blocking(tcp_listener& this, bool is_blocking) {
    int flags = fcntl(this.fd, F_GETFL, 0);
    
    if (flags == -1) return _::none();

    if (is_blocking) {
        flags &= ~O_NONBLOCK;
    } else {
        flags |= O_NONBLOCK;
    }
        
    return _::some();
}

// tcp_stream logic

std::opt(tcp_stream) tcp_listener::accept(tcp_listener& this) {
    std::net::endpoint remote;
    remote.length = (u32) sizeof(sockaddr_in);

    i32 fd = accept(this.fd, (sockaddr*) &remote.address, &remote.length);

    if (fd < 0) {
        return _::none();
    }

    return _::some((tcp_stream) { .fd = fd });
}

std::opt(u64) tcp_stream::read(tcp_stream& this, void* buffer, u64 capacity) {
    i64 received = read(this.fd, buffer, capacity);

    if (received < 0) {
        return _::none();
    }

    return _::some((u64) received);
}

std::opt(u64) tcp_stream::write(tcp_stream& this, const std::span(const u8) buffer) {
    i64 sent = write(this.fd, buffer.data, buffer.length);

    if (sent < 0) {
        return _::none();
    }

    return _::some((u64) sent);
}

void tcp_stream::close(tcp_stream this) {
    close(this.fd);
    @leak(this);
}
