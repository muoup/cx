import std::{collections::span, result, net::{address, error}} as std;
import std::platform::posix::socket as std::posix;

public:

struct tcp_server : @nodrop {
    std::posix::socket backend;
};

struct tcp_connection : @nodrop {
    std::posix::socket backend;
    std::endpoint peer;
};

std::result(tcp_server, std::socket_error) tcp_server::new() {
    auto backend = std::posix::socket::open(std::posix::stream_socket)
        |> std::result::try()!;

    std::posix::socket::set_reuse_address(backend, true)
        |> std::result::try_or(emit .{ std::posix::socket::close(move backend); })!;

    return _::ok((tcp_server) { .backend = move backend });
}

std::result(tcp_connection, std::socket_error) tcp_connection::connect_to(std::endpoint address) {
    auto backend = std::posix::socket::open(std::posix::stream_socket)
        |> std::result::try()!;
    std::posix::socket::connect(backend, address)
        |> std::result::try_or(emit .{ std::posix::socket::close(move backend); })!;
    return _::ok((tcp_connection) { .backend = move backend, .peer = address });
}

void tcp_server::drop(tcp_server server) {
    @unpack(move server) { backend: backend };
    std::posix::socket::close(move backend);
}

void tcp_connection::drop(tcp_connection connection) {
    @unpack(move connection) { backend: backend };
    std::posix::socket::close(move backend);
}

std::result(void, std::socket_error) tcp_server::bind(tcp_server& server, std::endpoint address) {
    std::posix::socket::bind(server.backend, address)
        |> std::result::try()!;
    return std::posix::socket::listen(server.backend, 10);
}

std::result(std::endpoint, std::socket_error) tcp_server::local_address(tcp_server& server)
    => std::posix::socket::local_address(server.backend);

std::result(tcp_connection, std::socket_error) tcp_server::accept(tcp_server& server) {
    auto details = std::posix::socket::accept(server.backend)
        |> std::result::try()!;
    @unpack(move details) { connection: backend, remote: remote };
    return _::ok((tcp_connection) { .backend = move backend, .peer = remote });
}

std::result(void, std::socket_error) tcp_server::set_blocking(tcp_server& server, bool blocking)
    => std::posix::socket::set_blocking(server.backend, blocking);

std::result(void, std::socket_error) tcp_connection::send(tcp_connection& connection, std::span(const u8) data) {
    while (data.length != 0) {
        usize sent = std::posix::socket::write(connection.backend, data)
            |> std::result::try()!;
        if (sent == 0) return _::err(std::socket_error::write_zero());
        data.data += sent;
        data.length -= sent;
    }
    return _::ok();
}

std::result(std::span(u8), std::socket_error) tcp_connection::read(tcp_connection& connection, std::span(u8) buffer)
    => std::posix::socket::read(connection.backend, buffer);

std::endpoint& tcp_connection::remote(tcp_connection& connection) => connection.peer;
