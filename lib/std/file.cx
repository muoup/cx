import std::optional as std;
import std::string as std;

extern "C":

#include <stdio.h>

public:

struct file : @nodrop {
    FILE* handle;
};

std::opt<file> file::open(const char* path, const char* mode) {
    FILE* handle = fopen(path, mode);
    
    if (handle == NULL) {
        return std::optional::opt::none<file>();
    }
    
    return std::opt::some<file>((file) { .handle = handle });
}

void file::close(file this) {
    fclose(this.handle);
    @leak(this);
}

void file::write(file& this, const char* data) {
    if (this.handle != NULL) {
        fputs(data, this.handle);
    }
}

void file::write_line(file& this, const char* data) {
    if (this.handle != NULL) {
        fputs(data, this.handle);
        fputc('\n', this.handle);
    }
}

void file::flush(file& this) {
    if (this.handle != NULL) {
        fflush(this.handle);
    }
}

std::opt<usize> file::read_line(file& this, char* buffer, u64 buffer_size) {
    if (this.handle == NULL) return std::opt::none();

    return fgets(buffer, buffer_size, this.handle)
        |> std::opt::some();
}

std::opt<usize> file::read(file& this, char* buffer, u64 buffer_size) {
    if (this.handle == NULL) return std::opt::none();

    return fread(buffer, 1, buffer_size, this.handle)
        |> std::opt::some();
}

std::string file::read_to_string(file& this) {
    int c;
    std::string s = std::string::new();

    // TODO: Replace with faster buffering system
    while ((c = fgetc(this.handle)) != EOF) {
        s |> std::string::append_char((char)c);
    }

    return move s;
}