import std::optional as std;
import std::io as std;
import std::string as std;

extern "C":
void exit(int status);

#include <stdio.h>
#include <string.h>

public:

comptime @type span(comptime @type T) =>
    struct {
        T* data;
        usize length;
    };

usize span::size(comptime @type T = _, span(T)& this) {
    return this.length;
}

span(const u8) span::str_as_bytes(const _str& this) {
    return (span(const u8)) {
        .data = (u8*) this,
        .length = strlen((u8*) this)
    };
}

const _str& span::as_str(span(const u8)& this) {
    return (const _str&) this.data;
}

_str& span::as_str_mut(span(u8)& this) {
    return (_str&) this.data;
}

std::opt(T&) span::get(comptime @type T = _, span(T)& this, usize index) {
    if (index >= this.length) {
        return _::none();
    }

    return this.data[index];
}

T& span::at(comptime @type T = _, span(T)& this, usize index) {
    if (index >= this.length) {
        printf("Index out of bounds: %d >= %d\n", index, this.length);
        exit(1);
    }

    return this.data[index];
}

std::opt(T&) span::first(comptime @type T = _, span(T)& this) {
    return this |>(1) span::get(T, 0);
}

std::opt(T&) span::last(comptime @type T = _, span(T)& this) {
    if (this.length == 0) {
        return _::none();
    }

    return _::some(this.data[this.length - 1]);
}
