import std::optional as std;
import std::io as std;

extern "C":
#include <stdio.h>

public:

struct span<T> {
    T* data;
    usize length;
};

usize span::size<T>(span<T>& this) {
    return this.length;
}

std::opt<T&> span::get<T>(span<T>& this, usize index) {
    if (index >= this.length) {
        return std::none;
    }

    return this.data[index];
}

T& span::at<T>(span<T>& this, usize index) {
    if (index >= this.length) {
        printf("Index out of bounds: %d >= %d\n", index, this.length);
    }

    return this.data[index];
}

std::opt<T&> span::first<T>(span<T>& this) {
    return this |> span::get<T>(0);
}

std::opt<T&> span::last<T>(span<T>& this) {
    if (this.length == 0) {
        return std::none;
    }

    return this.data[this.length - 1];
}
