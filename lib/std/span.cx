import std::optional as std;
import std::io as std;
import std::string as std;

extern "C":
void exit(int status);

#include <stdio.h>
#include <string.h>

public:

struct span<T> {
    T* data;
    usize length;
};

usize span::size<T>(span<T>& this) {
    return this.length;
}

span<const u8> span::str_as_bytes(const _str& this) {
    return (span<const u8>) {
        .data = (u8*) this,
        .length = strlen((u8*) this)
    };
}

_str& span::as_str(span<const u8>& this) {
    return (_str&) this.data;
}

std::opt<T&> span::get<T>(span<T>& this, usize index) {
    if (index >= this.length) {
        return std::none;
    }

    return this.data[index];
}

T& span::at<T>(span<T>& this, usize index) {
    if (index >= this.length) {
        printf("Index out of bounds: %d >= %d\n", index, this.length);
        exit(1);
    }

    return this.data[index];
}

std::opt<T&> span::first<T>(span<T>& this) {
    return this |> span::get<T>(0);
}

std::opt<T&> span::last<T>(span<T>& this) {
    if (this.length == 0) {
        return std::opt::none();
    }

    return std::opt::some(this.data[this.length - 1]);
}
