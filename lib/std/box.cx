public:

struct box<T> : @nodrop {
    T* ptr;
};

box<T> box::new<T>(T value) safe {
    @unsafe {
        box<T> b = (box<T>) {
            .ptr = malloc(sizeof(T))
        };
        *(b.ptr) = move value;
        return (move b);
    };
}

const T& box::deref<T>(const box<T>& this) {
    return *(this.ptr);
}

T& box::deref_mut<T>(box<T>& this) {
    return *(this.ptr);
}

// TODO: Bound this type as not @pinned when that feature is added
T box::unwrap<T>(box<T> this) safe {
    T inner = move @adopt(*this.ptr);
    @leak(this);
    return move inner;
}

T* box::leak<T>(box<T> this) {
    T* ptr = this.ptr;
    @leak(this);
    return ptr;
}

void box::drop_with<T>(box<T> this, void(*drop_value)(T)) {
    @unsafe {
        drop_value(@adopt(*this.ptr));
    };

    this.drop();
}

void box::drop<T>(box<T> this) safe {
    @unsafe {
        free(this.ptr);
        @leak(this);
    };
}

private:

#include <stdlib.h>
