#include <stdlib.h>
#include <string.h>

import std::{optional, io, math} as std;

extern "C":

void* aligned_alloc(usize alignment, usize size);

public:

comptime type raw_allocation = struct : @nodrop { void* data; usize size; };

comptime type fn_alloc = fn(^usize) -> ^std::opt(raw_allocation);
comptime type fn_realloc = fn(^raw_allocation, ^usize) -> ^raw_allocation;
comptime type fn_free = fn(^raw_allocation) -> ^void;

comptime type allocator = struct : @comptime {
    fn_alloc allocate;
    fn_free deallocate;

    std::opt(fn_realloc) realloc;
};
comptime type allocation(comptime allocator A) = @strong raw_allocation;

comptime allocator allocator::new(fn_alloc A, fn_free F, std::opt(fn_realloc) R = _::none())
    => { .allocate = A, .deallocate = F, .realloc = R };

auto allocate(comptime allocator A, usize len) -> allocation(A)
    => try_allocate(A, len) |> std::opt::expect("Allocation failed");

auto allocate_aligned(comptime allocator A, usize len, usize alignment) -> allocation(A)
    => try_allocate_aligned(A, len, alignment) |> std::opt::expect("Allocation failed");
    
auto try_allocate(comptime allocator A, usize len) -> std::opt(allocation(A))
    => A.allocate(emit len, emit 0) |> std::opt::map(|auto raw| => (allocation(A)) raw);

auto try_allocate_aligned(comptime allocator A, usize len, usize alignment) -> std::opt(allocation(A))
    => A.allocate(emit len, emit alignment) |> std::opt::map(|auto raw| => (allocation(A)) raw);
    
void deallocate(comptime allocator A = _, allocation(A) alloc)
    => A.deallocate(emit (raw_allocation) move alloc);

comptime auto reallocate(comptime allocator A, ^allocation(A) alloc, ^usize new_size) -> ^allocation(A)
    => match (A.realloc) {
        some(auto& R) => emit (allocation(A)) R(emit (raw_allocation) alloc, new_size),
        none() => reallocate_fallback(A, alloc, new_size),
    };

void reallocate_inplace(comptime allocator A, allocation(A)& alloc, usize new_size) {
    auto old_alloc = @adopt(alloc);
    auto new_alloc = reallocate(A, emit move old_alloc, emit new_size);
    old_alloc = move new_alloc;
    @leak(old_alloc);
}

comptime auto reallocate_fallback(comptime allocator A, ^allocation(A) alloc, ^usize new_size) -> ^allocation(A)
    => emit .{
        auto old_alloc = alloc;
        auto buffer = allocate(A, new_size);
        memcpy(buffer.data, old_alloc.data, std::min(buffer.size, old_alloc.size));

        move old_alloc |> deallocate();
        yield move buffer;
    };

comptime allocator heap_allocator = allocator::new(
    heap_allocator::allocate,
    heap_allocator::deallocate,
    .R = _::some(heap_allocator::reallocate)
);

auto heap_allocator::allocate(usize size, usize alignment) -> std::opt(raw_allocation) {
    void* data = alignment == 0 ? malloc(size) : aligned_alloc(size, alignment);
    
    return std::opt::if_then(emit data != NULL, emit (raw_allocation) { data, size });
}

auto heap_allocator::reallocate(raw_allocation alloc, usize new_size) -> raw_allocation {
    alloc.data = realloc(alloc.data, new_size);
    alloc.size = new_size;
    return move alloc;
}

void heap_allocator::deallocate(raw_allocation alloc) {
    free(alloc.data);
    @leak(alloc);
}
