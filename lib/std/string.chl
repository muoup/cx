import std::{optional, io, span, vector, allocation} as std;

extern "C":

#include <stdlib.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

public:

comptime type string(std::allocator A = std::heap_allocator) 
    => @strong std::vector(u8, .A = A);

// std::string implementations

string(.A = A) string::new(comptime std::allocator A = std::heap_allocator)
    => (string(.A = A)) std::vector::new(u8);

string(.A = A) string::clone(const string(.A = _: A)& this) => this |> string::as_str() |> string::from_str();

void string::drop(string(.A = _: A) this)
    => move this |> string::into_bytes() |> std::vector::drop();

string(.A = A) string::from_str(comptime std::allocator A = std::heap_allocator, const _str& s) {
    string new_string = string::new();
    new_string |> string::append_str(s);
    return move new_string;
}

string(.A = A) string::from_bytes(comptime std::allocator A = std::heap_allocator, std::span(const u8) this) {
    string str = string::new();
    string::append_span(str, this);
    return move str;
}

const _str& string::as_str(const string(.A = _)& this) {
    // SAFETY: We ensure via our API that our internal const char* is a valid c-string with null-termination,
    // so this cast is safe as long as the caller does not mutate the string data through the returned reference.
    return @unsafe((const _str&) (char*) this.alloc.data);
}

_str& string::as_str_mut(string(.A = _)& this) {
    // SAFETY: See string::as_str above
    return @unsafe((_str&) (char*) this.alloc.data);
}

std::span(u8) string::as_bytes(string(.A = _)& this)
    => std::span::new(this.data, this.length);

std::span(const u8) string::as_const_bytes(const string(.A = _)& this)
    => std::span::new(this.data, this.length);
    
std::vector(u8, .A = A) string::into_bytes(string(.A = _: A) this) {
    return move (std::vector(u8, .A = A)) this;
}

void string::append_str(string(.A = _)& this, const _str& s) {
    usize str_length = str::length(s);
    auto span = std::span::new(.T = const char, (const char*) s, str_length);
    string::append_span(this, span);
}

void string::append_span(string(.A = _)& this, std::span(const char) span) {
    u64 length = span |> std::span::length();

    while (this.length + span.length + 1 >= this.capacity) {
        this |> string::_realloc();
    }
    
    memcpy(this.alloc.data + this.length, span |> std::span::data(), length);
    this.length = length + this.length;
    (this |> string::as_str_mut())[this.length] = 0;
}

void string::append_byte(string(.A = _)& this, char c) {
    this |> string::underlying_ref() |> std::vector::push(c);
    this |> string::underlying_ref() |> std::vector::push(0);
}

bool string::equals(const string(.A = _)& this, const string& other) {
    if (this.length != other.length) {
        return false;
    }
    return strcmp(this.data, other.data) == 0;
}

string str::substring(const _str& this, usize start, usize end) {
    if (start > end || end > strlen(this)) {
        std::io::println("Invalid substring range");
        @unsafe(exit(1));
    }

    string result = string::new();
    for (usize i = start; i < end; i++) {
        result |> string::append_char(this[i]);
    }
    return move result;
}
    
bool str::equals(const _str& this, const _str& other) {
    return strcmp(this, other) == 0;
}

usize str::length(const _str& this) {
    return strlen(this);
}

std::span(u8) str::as_bytes(_str& this) {
    usize len = str::length(this);

    return std::span::new((u8*) this, len);
}

std::span(const u8) str::as_const_bytes(const _str& this) {
    usize len = str::length(this);
    
    return std::span::new((const u8*) this, len);
}

private:

std::vector(u8, .A = A)& string::underlying_ref(string(.A = _: A)& this)
    => *(std::vector(u8, .A = A)*) &this;

void string::_realloc(string(.A = _: A)& this) {
    this 
        |> string::underlying_ref() 
        |> std::vector::force_grow();
}
