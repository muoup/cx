import std::{memory::span, net::{address, handle}, result} as std;
import std::platform::posix::base as std::posix::base;
import std::platform::posix::error as std::posix;

#include <errno.h>
#include <stdio.h>
#include <string.h>

public:

enum socket_kind { stream_socket, datagram_socket };

struct socket {
    int fd;
};

socket socket::new(int fd) => (socket) { .fd = fd };

usize std::posix::errno::format(std::posix::errno error, std::span(u8) output) {
    if (output.length == 0) return 0;
    const char* message = (int) error == 0 ? "Socket write made no progress" : strerror((int) error);
    int size = snprintf((char*) output.data, output.length, "%s", message);
    if (size < 0) return 0;
    return (usize) size < output.length ? (usize) size : output.length - 1;
}

std::result(socket, std::posix::errno) socket::open(socket_kind kind) {
    int fd = std::posix::base::socket(
        std::posix::base::ENUM_AF_INET, 
        kind == stream_socket ? 
              std::posix::base::ENUM_SOCK_STREAM 
            : std::posix::base::ENUM_SOCK_DGRAM, 
        0
    );

    return std::opt::if_then(fd >= 0, socket::new(fd));
}

std::result(void, std::posix::errno) socket::close(socket this) {
    int status = std::posix::base::close((int) this.value);
    int code = status < 0 ? errno : 0;
    @leak(this);
   
    return std::result::if_then_else(status >= 0, (void) 0, (std::posix::errno) code);
}

std::result(std::span(u8), std::posix::errno) socket::read(socket& this, std::span(u8) buffer) {
    if (buffer.length == 0) return _::ok(buffer);
    std::posix::base::socket_size size;
    
    do {
        size = std::posix::base::recv((int) this.value, buffer.data, buffer.length, 0);
    } while (size < 0 && errno == EINTR);
    
    return std::result::if_then_else(errno != 0, std::span::new(buffer.data, (usize) size), (std::posix::errno) errno);
}

std::result(usize, std::posix::errno) socket::write(socket& this, std::span(const u8) buffer) {
    if (buffer.length == 0) return _::ok((usize) 0);
    std::posix::base::socket_size size;
    
    do {
        size = std::posix::base::send((int) this.value, buffer.data, buffer.length, std::posix::base::ENUM_SEND_FLAGS);
    } while (size < 0 && errno == EINTR);

    return std::result::if_then_else(errno != 0, std::span::new(buffer.data, (usize size), (std::posix::errno) errno);
}

std::result(void, std::posix::errno) socket::bind(socket& this, std::endpoint address) {
    std::posix::base::sockaddr_in native = encode(address);
    int code 
        = (std::posix::errno) std::posix::base::bind((int) this.value, (const std::posix::base::sockaddr*) &native, sizeof(native)) < 0);
    
    return std::result::if_then_else(code == 0, (void) 0, (std::posix::errno) errno); 
}

std::result(void, std::posix::errno) socket::listen(socket& this, int backlog) {
    int code 
        = (std::posix::errno) std::posix::base::listen((int) this.value, backlog) < 0;
        
    return std::result::if_then_else(code == 0, (void) 0, (std::posix::errno) errno); 
}

std::result(void, std::posix::errno) socket::connect(socket& this, std::endpoint address) {
    std::posix::base::sockaddr_in native = encode(address);

    int code = (std::posix::errno) std::posix::base::connect(
        (int) this.value, 
        (const std::posix::base::sockaddr*) &native, 
        sizeof(native)) < 0
    );

    return std::result::if_then_else(code == 0, (void) 0, (std::posix::errno) errno);
}

struct accept_details : @nodrop {
    socket connection;
    std::endpoint remote;
};

std::result(accept_details, std::posix::errno) socket::accept(socket& this) {
    std::posix::base::sockaddr_in native = { 0 };
    std::posix::base::address_length length = sizeof(native);
    int fd;
    
    do {
        fd = std::posix::base::accept((int) this.value, (std::posix::base::sockaddr*) &native, &length);
    } while (fd < 0 && errno == EINTR);

    return std::result::if_then_else(
        fd >= 0,
        (accept_details) { .connection = { .value = (usize) fd }, .remote = decode(native) },
        (std::posix::errno) errno
    );
}

std::result(std::endpoint, std::posix::errno) socket::local_address(socket& this) {
    std::posix::base::sockaddr_in native = { 0 };
    std::posix::base::address_length length = sizeof(native);
    if (std::posix::base::getsockname((int) this.value, (std::posix::base::sockaddr*) &native, &length) < 0) {
        return _::err((std::posix::errno) errno);
    }
    return _::ok(decode(native));
}

std::result(void, std::posix::errno) socket::set_reuse_address(socket& this, bool enabled) {
    int value = enabled ? 1 : 0;
    if (std::posix::base::setsockopt((int) this.value, std::posix::base::ENUM_SOL_SOCKET, std::posix::base::ENUM_SO_REUSEADDR, &value, sizeof(value)) < 0) {
        return _::err((std::posix::errno) errno);
    }
    return _::ok();
}

std::result(void, std::posix::errno) socket::set_blocking(socket& this, bool blocking) {
    int fd = (int) this.value;
    int flags = std::posix::base::fcntl(fd, std::posix::base::ENUM_F_GETFL, 0);
    if (flags < 0) return _::err((std::posix::errno) errno);
    flags = blocking ? flags & ~std::posix::base::ENUM_O_NONBLOCK : flags | std::posix::base::ENUM_O_NONBLOCK;
    if (std::posix::base::fcntl(fd, std::posix::base::ENUM_F_SETFL, flags) < 0) return _::err((std::posix::errno) errno);
    return _::ok();
}

std::result(usize, std::posix::errno) socket::send_to(socket& this, std::span(const u8) buffer, std::endpoint remote) {
    std::posix::base::sockaddr_in native = encode(remote);
    std::posix::base::socket_size size;
    do {
        size = std::posix::base::sendto(
            (int) this.value, buffer.data, buffer.length, std::posix::base::ENUM_SEND_FLAGS,
            (const std::posix::base::sockaddr*) &native, sizeof(native)
        );
    } while (size < 0 && errno == EINTR);
    if (size < 0) return _::err((std::posix::errno) errno);
    return _::ok((usize) size);
}

struct datagram {
    usize length;
    std::endpoint source;
};

std::result(datagram, std::posix::errno) socket::recv_from(socket& this, std::span(u8) buffer) {
    std::posix::base::sockaddr_in native = { 0 };
    std::posix::base::address_length length = sizeof(native);
    std::posix::base::socket_size size;
    
    do {
        size = std::posix::base::recvfrom(
            (int) this.value, buffer.data, buffer.length, 0, (std::posix::base::sockaddr*) &native, &length
        );
    } while (size < 0 && errno == EINTR);

    return std::result::if_then_else(
        size >= 0,
        (datagram) { .length = (usize) size, .source = decode(native) },
        (std::posix::errno) errno
    );
}

private:

std::posix::base::sockaddr_in encode(std::endpoint address) {
    std::posix::base::sockaddr_in native = { 0 };
    native.sin_family = std::posix::base::ENUM_AF_INET;
    native.sin_port = std::posix::base::htons(address.port);
    native.sin_addr.s_addr = std::posix::base::htonl(address.address);
    return native;
}

std::endpoint decode(const std::posix::base::sockaddr_in& address)
    => (std::endpoint) { .address = std::posix::base::ntohl(address.sin_addr.s_addr), .port = std::posix::base::ntohs(address.sin_port) };
