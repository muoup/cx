import std::{collections::span, net::{address, error}, result} as std;
import std::platform::posix as std::posix::raw;
import std::platform::posix::error as std::posix;

public:

enum socket_kind { stream_socket, datagram_socket };

struct socket : @nodrop {
    int fd;
};

socket socket::new(int fd) => (socket) { .fd = fd };

std::result(socket, std::socket_error) socket::open(socket_kind kind) {
    auto native_kind = kind == stream_socket ? std::posix::raw::socket_type::STREAM : std::posix::raw::socket_type::DGRAM;
    auto fd = std::posix::raw::socket(std::posix::raw::addr_family::INET, native_kind, 0);
    return std::result::if_then_else(
        emit std::posix::fd_result::is_ok(fd), emit socket::new((int) fd), emit current_socket_error()
    );
}

std::result(void, std::socket_error) socket::close(socket this) {
    auto status = std::posix::raw::close(this.fd);
    @leak(this);
    return status_result(status);
}

std::result(std::span(u8), std::socket_error) socket::read(socket& this, std::span(u8) buffer) {
    if (buffer.length == 0) return _::ok(buffer);
    isize size;

    do {
        size = std::posix::raw::recv(this.fd, buffer.data, buffer.length, std::posix::raw::recv_flags::NONE);
    } while (size < 0 && std::posix::errno_code::current() == interrupted);

    return std::result::if_then_else(
        emit size >= 0, emit std::span::new(buffer.data, (usize) size), emit current_socket_error()
    );
}

std::result(usize, std::socket_error) socket::write(socket& this, std::span(const u8) buffer) {
    if (buffer.length == 0) return _::ok((usize) 0);
    isize size;

    do {
        size = std::posix::raw::send(this.fd, buffer.data, buffer.length, std::posix::raw::send_flags::NO_SIGNAL);
    } while (size < 0 && std::posix::errno_code::current() == interrupted);

    return std::result::if_then_else(emit size >= 0, emit (usize) size, emit current_socket_error());
}

std::result(void, std::socket_error) socket::bind(socket& this, std::endpoint address) {
    std::posix::raw::sockaddr_in native = encode(address);
    return status_result(std::posix::raw::bind(this.fd, (const std::posix::raw::sockaddr*) &native, sizeof(native)));
}

std::result(void, std::socket_error) socket::listen(socket& this, int backlog)
    => status_result(std::posix::raw::listen(this.fd, backlog));

std::result(void, std::socket_error) socket::connect(socket& this, std::endpoint address) {
    std::posix::raw::sockaddr_in native = encode(address);
    return status_result(std::posix::raw::connect(this.fd, (const std::posix::raw::sockaddr*) &native, sizeof(native)));
}

struct accept_details : @nodrop {
    socket connection;
    std::endpoint remote;
};

std::result(accept_details, std::socket_error) socket::accept(socket& this) {
    std::posix::raw::sockaddr_in native = { 0 };
    std::posix::raw::socklen_t length = sizeof(native);
    std::posix::raw::fd_result fd;
    do {
        fd = std::posix::raw::accept(this.fd, (std::posix::raw::sockaddr*) &native, &length);
    } while (!std::posix::fd_result::is_ok(fd) && std::posix::errno_code::current() == interrupted);

    return std::result::if_then_else(
        emit std::posix::fd_result::is_ok(fd),
        emit (accept_details) { .connection = socket::new((int) fd), .remote = decode(native) },
        emit current_socket_error()
    );
}

std::result(std::endpoint, std::socket_error) socket::local_address(socket& this) {
    std::posix::raw::sockaddr_in native = { 0 };
    std::posix::raw::socklen_t length = sizeof(native);
    auto status = std::posix::raw::getsockname(this.fd, (std::posix::raw::sockaddr*) &native, &length);
    return std::result::if_then_else(
        emit std::posix::posix_status::is_ok(status), emit decode(native), emit current_socket_error()
    );
}

std::result(void, std::socket_error) socket::set_reuse_address(socket& this, bool enabled) {
    int value = enabled ? 1 : 0;
    return status_result(std::posix::raw::setsockopt(
        this.fd, std::posix::raw::socket_option_level::SOCKET, std::posix::raw::socket_option::REUSEADDR,
        &value, sizeof(value)
    ));
}

std::result(void, std::socket_error) socket::set_blocking(socket& this, bool blocking) {
    int status = std::posix::raw::fcntl(this.fd, std::posix::raw::fcntl_command::GETFL, 0);
    if (status < 0) return _::err(current_socket_error());
    auto flags = (std::posix::raw::file_status_flags) status;
    auto nonblock = std::posix::raw::file_status_flags::NONBLOCK;
    flags = blocking ? flags & ~nonblock : flags | nonblock;
    return status_result((std::posix::raw::posix_status) std::posix::raw::fcntl(
        this.fd, std::posix::raw::fcntl_command::SETFL, (int) flags
    ));
}

std::result(usize, std::socket_error) socket::send_to(socket& this, std::span(const u8) buffer, std::endpoint remote) {
    std::posix::raw::sockaddr_in native = encode(remote);
    isize size;
    do {
        size = std::posix::raw::sendto(
            this.fd, buffer.data, buffer.length, std::posix::raw::send_flags::NO_SIGNAL,
            (const std::posix::raw::sockaddr*) &native, sizeof(native)
        );
    } while (size < 0 && std::posix::errno_code::current() == interrupted);

    return std::result::if_then_else(emit size >= 0, emit (usize) size, emit current_socket_error());
}

struct datagram {
    usize length;
    std::endpoint source;
};

std::result(datagram, std::socket_error) socket::recv_from(socket& this, std::span(u8) buffer) {
    std::posix::raw::sockaddr_in native = { 0 };
    std::posix::raw::socklen_t length = sizeof(native);
    isize size;
    do {
        size = std::posix::raw::recvfrom(
            this.fd, buffer.data, buffer.length, std::posix::raw::recv_flags::NONE,
            (std::posix::raw::sockaddr*) &native, &length
        );
    } while (size < 0 && std::posix::errno_code::current() == interrupted);

    return std::result::if_then_else(
        emit size >= 0,
        emit (datagram) { .length = (usize) size, .source = decode(native) },
        emit current_socket_error()
    );
}

private:

comptime std::posix::raw::errno_code interrupted = (std::posix::raw::errno_code) std::posix::raw::errno_type::INTR;

std::socket_error current_socket_error()
    => std::posix::errno_code::into_socket_error(std::posix::errno_code::current());

std::result(void, std::socket_error) status_result(std::posix::raw::posix_status status)
    => std::result::if_then_else(emit std::posix::posix_status::is_ok(status), emit (void) 0, emit current_socket_error());

std::posix::raw::sockaddr_in encode(std::endpoint address) {
    std::posix::raw::sockaddr_in native = { 0 };
    native.sin_family = (int) std::posix::raw::addr_family::INET;
    native.sin_port = std::posix::raw::htons(address.port);
    native.sin_addr.s_addr = std::posix::raw::htonl(address.address);
    return native;
}

std::endpoint decode(const std::posix::raw::sockaddr_in& address)
    => (std::endpoint) {
        .address = std::posix::raw::ntohl(address.sin_addr.s_addr),
        .port = std::posix::raw::ntohs(address.sin_port)
    };
