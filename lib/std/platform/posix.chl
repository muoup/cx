public extern "C":

#include <errno.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <fcntl.h>

public:

comptime errno_code ERRNO_EINTR = (errno_code) EINTR;

comptime int ENUM_O_NONBLOCK = O_NONBLOCK;

comptime int ENUM_F_DUPFD = F_DUPFD;
comptime int ENUM_F_DUPFD_CLOEXEC = F_DUPFD_CLOEXEC;
comptime int ENUM_F_GETFD = F_GETFD;
comptime int ENUM_F_SETFD = F_SETFD;
comptime int ENUM_F_GETFL = F_GETFL;
comptime int ENUM_F_SETFL = F_SETFL;
comptime int ENUM_F_SETLK = F_SETLK;
comptime int ENUM_F_SETLKW = F_SETLKW;

comptime int ENUM_AF_UNSPEC = AF_UNSPEC;
comptime int ENUM_AF_UNIX = AF_UNIX;
comptime int ENUM_AF_INET = AF_INET;
comptime int ENUM_AF_INET6 = AF_INET6;
comptime int ENUM_AF_PACKET = AF_PACKET;

comptime int ENUM_SOCK_STREAM = SOCK_STREAM;
comptime int ENUM_SOCK_DGRAM = SOCK_DGRAM;
comptime int ENUM_SOCK_RAW = SOCK_RAW;
comptime int ENUM_SOCK_SEQPACKET = SOCK_SEQPACKET;

comptime int ENUM_IPPROTO_IP = IPPROTO_IP;
comptime int ENUM_IPPROTO_ICMP = IPPROTO_ICMP;
comptime int ENUM_IPPROTO_TCP = IPPROTO_TCP;
comptime int ENUM_IPPROTO_UDP = IPPROTO_UDP;
comptime int ENUM_IPPROTO_IPV6 = IPPROTO_IPV6;
comptime int ENUM_IPPROTO_RAW = IPPROTO_RAW;

#if defined(MSG_NOSIGNAL)
comptime int send_flags = MSG_NOSIGNAL;
#elif defined(SO_NOSIGPIPE)
comptime int send_flags = SO_NOSIGPIPE;
#else
comptime int send_flags = 0;
#end
