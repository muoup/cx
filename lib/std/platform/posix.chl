// sys/socket.h bindings

typedef struct sockaddr sockaddr;
typedef struct sockaddr_in sockaddr_in;
typedef socklen_t address_length;
typedef ssize_t socket_size;

comptime int ENUM_SOL_SOCKET = SOL_SOCKET;
comptime int ENUM_SO_REUSEADDR = SO_REUSEADDR;

#ifdef MSG_NOSIGNAL
comptime int ENUM_SEND_FLAGS = MSG_NOSIGNAL;
#else
comptime int ENUM_SEND_FLAGS = 0;
#endif

u16 htons(u16 port);
u16 ntohs(u16 port);
u32 htonl(u32 address);
u32 ntohl(u32 address);

comptime int ENUM_AF_UNSPEC = AF_UNSPEC;
comptime int ENUM_AF_UNIX = AF_UNIX;
comptime int ENUM_AF_INET = AF_INET;
comptime int ENUM_AF_INET6 = AF_INET6;
comptime int ENUM_AF_PACKET = AF_PACKET;

comptime int ENUM_SOCK_STREAM = SOCK_STREAM;
comptime int ENUM_SOCK_DGRAM = SOCK_DGRAM;
comptime int ENUM_SOCK_RAW = SOCK_RAW;
comptime int ENUM_SOCK_SEQPACKET = SOCK_SEQPACKET;

comptime int ENUM_IPPROTO_IP = IPPROTO_IP;
comptime int ENUM_IPPROTO_ICMP = IPPROTO_ICMP;
comptime int ENUM_IPPROTO_TCP = IPPROTO_TCP;
comptime int ENUM_IPPROTO_UDP = IPPROTO_UDP;
comptime int ENUM_IPPROTO_IPV6 = IPPROTO_IPV6;
comptime int ENUM_IPPROTO_RAW = IPPROTO_RAW;

int     accept(int socket, struct sockaddr *address, socklen_t *address_len);
int     bind(int socket, const struct sockaddr *address, socklen_t address_len);
int     connect(int socket, const struct sockaddr *address, socklen_t address_len);

int     getpeername(int socket, struct sockaddr *address, socklen_t *address_len);
int     getsockname(int socket, struct sockaddr *address, socklen_t *address_len);
int     getsockopt(int socket, int level, int option_name, void *option_value, socklen_t *option_len);

int     listen(int socket, int backlog);
ssize_t recv(int socket, void *buffer, size_t length, int flags);
ssize_t recvfrom(int socket, void *buffer, size_t length, int flags, struct sockaddr *address, socklen_t *address_len);
ssize_t recvmsg(int socket, struct msghdr *message, int flags);

ssize_t send(int socket, const void *message, size_t length, int flags);
ssize_t sendmsg(int socket, const struct msghdr *message, int flags);
ssize_t sendto(int socket, const void *message, size_t length, int flags, const struct sockaddr *dest_addr, socklen_t dest_len);

int     setsockopt(int socket, int level, int option_name, const void *option_value, socklen_t option_len);
int     shutdown(int socket, int how);
int     socket(int domain, int socket_type, int protocol);
int     socketpair(int domain, int socket_type, int protocol, int socket_vector[2]);