import std::panic as std;

public:

comptime @type rcell(@type T) =>
    struct : @copy_traits(T), @unsafe_move {
        T inner;
        i16 sema;
    };

rcell(T) rcell::new(@type T, T val) {
    return (rcell(T)) {
        .inner = val,
        .sema = 0
    };
}

comptime expr(void) rcell::borrow_const(@type T, expr(rcell(T)&) cell, @fn proc(expr(const T&)) -> expr(void)) =>
    emit .{
        if (cell.sema < 0) {
            std::panic("Cannot immutably borrow cell while it is currently mutably borrowed");
        }
        cell.sema++;

        defer rcell::release_const(_, cell);
        proc(cell.inner);
    };

comptime expr(void) rcell::borrow(@type T, expr(rcell(T)&) cell, @fn proc(expr(T&)) -> expr(void)) =>
    emit .{
        if (cell.sema != 0) {
            std::panic("Cannot mutably borrow cell while it is currently borrowed");
        }
        cell.sema = -1;

        defer rcell::release(_, cell);
        proc(cell.inner);
    };

void rcell::release(@type T, rcell(T)& cell) /* not safe */ {
    cell.sema = 0;
}

void rcell::release_const(@type T, rcell(T)& cell) /* not safe */ {
    cell.sema--;
}
