import std::span as std;

#include <stdio.h>

public extern "C": int printf(const char *__restrict format, ...);

public:

///
/// Writes the provided ASCII string to stdout
///
void print(const _str& s) {
    printf(s);
}

///
/// Writes the provided ASCII string follwed by a new line to stddout
///
void println(const _str& s) {
    puts(s);
}

///
/// Writes the provided ASCII character to stdout
///
void print_char(i32 c) {
    putchar(c);
}

///
/// Writes the provided ASCII character span to stdout
///
void print_span(const std::span(char) data_str) {
    fwrite(data_str |> std::span::data(), data_str |> std::span::length(), 1, stdout); 
}