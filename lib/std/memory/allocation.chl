#include <stdlib.h>
#include <string.h>

import std::{optional, panic, math} as std;

extern "C":

#ifdef _WIN32
void* _aligned_malloc(usize size, usize alignment);
void _aligned_free(void* pointer);
#else
int posix_memalign(void** pointer, usize alignment, usize size);
#endif

public:

comptime type raw_allocation = struct : @nodrop {
    void* data;
    usize size;
};

comptime type fn_alloc = fn(^usize) -> ^raw_allocation;
comptime type fn_free = fn(^raw_allocation) -> ^void;
comptime type fn_resize = fn(^raw_allocation, ^usize) -> ^raw_allocation;

comptime type allocator = struct : @comptime {
    fn_alloc allocate;
    fn_free deallocate;
    std::opt(fn_resize) realloc;

    usize alignment;
};

comptime allocator allocator::new(
    fn_alloc allocate,
    fn_free deallocate,
    std::opt(fn_resize) realloc = _::none(),
    usize alignment
)
    where pre: (@unsafe(valid_alignment(alignment)))
    => { .allocate = allocate, .deallocate = deallocate, .alignment = alignment, .realloc = realloc };

comptime type allocation(allocator A)
    => @strong raw_allocation;

comptime bool valid_alignment(usize alignment)
    => alignment != 0 && (alignment & (alignment - 1)) == 0;

auto try_allocate(comptime allocator A, usize size) -> std::opt(allocation(A)) {
    if (size == 0) return _::some({ NULL, 0 });

    void* data = A.allocate(emit size, emit allocation_alignment(A, alignment));
    return std::opt::if_then(emit data != NULL, emit { data, size } as allocation(A, allocation_alignment(A, alignment))); 
}

auto allocate(comptime allocator A, usize size) -> allocation(A)
    => try_allocate(A, size, .alignment = alignment) |> std::opt::expect("Allocation failed");

void deallocate(allocation(_: A) block) {
    if (block.size != 0) A.deallocate(emit block.data, emit block.size, emit alignment);
    @leak(block);
}

bool try_resize(allocation(_: A)& block, usize size) {
    if (size == block.size) return true;
    
    if (size == 0) {
        A.deallocate(emit block.data, emit block.size, emit alignment);
        block.data = NULL;
        block.size = 0;
        return true;
    }

    match (block.resize) {
        some(auto& realloc) => realloc(block)
    }
}

void resize(allocation(_: A)& block, usize size) {
    if (!try_resize(block, size)) std::panic("Allocation resize failed");
}

void* allocation::leak(allocation(_) allocation) {
    defer @leak(allocation);
    return allocation.data;
}

allocation(A) allocation::from_raw(comptime allocator A, void* data, usize size)
    => { .data = data, .size = size } as allocation(A);

comptime allocator heap_allocator = allocator::new(
    heap_allocate, 
    heap_free,
    .realloc = _::some(heap_realloc),
    1
);

comptime allocator aligned_heap_allocator(usize alignment) => allocator::new(
    aligned_heap_allocate(alignment), 
    aligned_heap_free(alignment),
    alignment,
);

private:

auto heap_allocate(usize size) -> raw_allocation 
    => { .data = malloc(size), .size = size };

void heap_free(raw_allocation data) {
    free(data.data);
    @leak(data);
}

auto heap_realloc(raw_allocation alloc, usize new_size) -> raw_allocation {
    defer @leak(alloc);
    return { .data = realloc(alloc.data, new_size), .size = new_size };
}

auto aligned_heap_allocate(comptime usize alignment, usize size) -> raw_allocation {
#ifdef _WIN32
    return _aligned_malloc(size, alignment);
#else
    void* data;
    usize native_alignment = std::max(alignment, sizeof(void*));
    if (posix_memalign(&data, native_alignment, size) != 0) return NULL;
    return data;
#endif
}

auto aligned_heap_free(comptime usize alignment, raw_allocation alloc) -> raw_allocation {
#ifdef _WIN32
    _aligned_free(alloc.data);
#else
    free(alloc.data);
#endif 
    @leak(alloc);
}
