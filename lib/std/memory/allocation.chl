#include <stdlib.h>
#include <string.h>

import std::{optional, panic, math, memory} as std;

extern "C":

#ifdef _WIN32
void* _aligned_malloc(usize size, usize alignment);
void _aligned_free(void* pointer);
#else
int posix_memalign(void** pointer, usize alignment, usize size);
#endif

public:

comptime type raw_allocation = struct : @nodrop {
    void* data;
    usize size;
};

comptime type fn_alloc = fn(^usize) -> ^std::opt(raw_allocation);
comptime type fn_resize = fn(^raw_allocation, ^usize) -> ^std::opt(raw_allocation);
comptime type fn_free = fn(^raw_allocation) -> ^void;

comptime type allocator = struct : @comptime {
    fn_alloc allocate;
    fn_free deallocate;
    std::opt(fn_resize) realloc;

    usize alignment;
};

comptime allocator allocator::new(
    fn_alloc allocate,
    fn_free deallocate,
    std::opt(fn_resize) realloc = _::none(),
    usize alignment
) => {
    .allocate = allocate, 
    .deallocate = deallocate, 
    .alignment = alignment, 
    .realloc = realloc 
};

comptime type allocation(allocator A)
    => @strong raw_allocation;

auto try_allocate(comptime allocator A, usize size) -> std::opt(allocation(A)) {
    if (size == 0) return _::some({ NULL, 0 });

    return A.allocate(emit size)
        |> std::opt::map(|auto val| => (allocation(A)) val);
}

auto allocate(comptime allocator A, usize size) -> allocation(A)
    => try_allocate(A, size) |> std::opt::expect("Allocation failed");

void deallocate(allocation(_: A) block) {
    if (block.size != 0) A.deallocate((raw_allocation) move block);
}

bool try_resize(allocation(_: A)& block, usize size) {
    if (size == block.size) return true;
    
    if (size == 0) {
        auto empty = allocate(A, 0);
        std::swap(block, empty);
        move empty |> deallocate();
        return true;
    }

    match (A.realloc) {
        some(auto& realloc) => realloc(block),
        none() => .{
            auto new_buffer = A.allocate(size);
            memcpy(new_buffer.data, block.data, size);
            std::swap(block, new_buffer);
            new_buffer |> deallocate();
            return true;
        },
    }
}

void resize(allocation(_: A)& block, usize size) {
    if (!try_resize(block, size)) std::panic("Allocation resize failed");
}

void* allocation::leak(allocation(_) allocation) {
    defer @leak(allocation);
    return allocation.data;
}

allocation(A) allocation::from_raw(comptime allocator A, void* data, usize size)
    => { .data = data, .size = size } as allocation(A);

comptime allocator heap_allocator = allocator::new(
    heap_allocate, 
    heap_free,
    .realloc = _::some(heap_realloc),
    1
);

comptime allocator aligned_heap_allocator(usize alignment) => allocator::new(
    aligned_heap_allocate(alignment), 
    aligned_heap_free(alignment),
    alignment,
);

private:

auto heap_allocate(usize size) -> std::opt(raw_allocation) {
    void* data = malloc(size);
    return std::opt::if_then(emit data != NULL, emit (raw_allocation) { .data = malloc(size), .size = size });
}

void heap_free(raw_allocation data) {
    free(data.data);
    @leak(data);
}

auto heap_realloc(raw_allocation alloc, usize new_size) -> std::opt(raw_allocation) {
    defer @leak(alloc);
    void* data = realloc(alloc.data, new_size);
    
    return std::opt::if_then(emit data != NULL, emit (raw_allocation) { .data = realloc(alloc.data, new_size), .size = new_size });
}

auto aligned_heap_allocate(comptime usize alignment, usize size) -> std::opt(raw_allocation) {
    void* data;
#ifdef _WIN32
    data = _aligned_malloc(size, alignment);
#else
    usize native_alignment = std::max(alignment, sizeof(void*));
    if (posix_memalign(&data, native_alignment, size) != 0) return NULL;
#endif

    return std::opt::if_then(emit data != NULL, emit (raw_allocation) { data, size });
}

void aligned_heap_free(comptime usize alignment, raw_allocation alloc) {
#ifdef _WIN32
    _aligned_free(alloc.data);
#else
    free(alloc.data);
#endif 
    @leak(alloc);
}
