import std::optional as std;
import std::io as std;
import std::file as std;
import std::string as std;

import interpreter;

i32 main(i32 argc, char** argv) {
    if (argc == 1) {
        std::println("Please include a file path as an argument to interpret");
        return 1;
    }

    std::opt<file> o = file::open(argv[1], "r");

    if (!o.is_some()) {
        println("Could not find file specified.");
    }

    std::file f = o.unwrap();
    std::string s = f.read_to_string();
    
    run(s.as_str());

    f.close();
    s.drop();
    return 0;
}
