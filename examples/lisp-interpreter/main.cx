import std::optional as std;
import std::io as std;
import std::file as std;
import std::string as std;

import ast as _;
import interpreter as _;

i32 main(i32 argc, char** argv) {
    if (argc == 1) {
        std::println("Please include a file path as an argument to interpret");
        return 1;
    }

    std::file f = std::file::open(argv[1], "r")
        |> std::opt::unwrap_or_else(.{ 
            std::println("Could not find file specified");
            return -1;
        });
    std::string s = f |> std::file::read_to_string();

    run(s |> std::string::as_str());

    move f |> std::file::close();
    move s |> std::string::drop();
    return 0;
}
