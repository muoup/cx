import std::box as std;
import std::vector as std;
import std::io as std;
import std::string as std;
import std::functional as std;
import std::span as std;

import ast as _;
import parser;

#include <stdlib.h>

public:

void interpret(lisp_node& node) {
    interpreter interpret = {
        .program_body = NULL,
        .program_length = 0
    };

    interpreter::interpreter::interpret(interpret, node);
}

void run(const _str& source) {
    parser::parse(source)
        |>(1) std::tap(ast::lisp_node, |t| emit interpret(t))
        |> lisp_node::drop();
}

private:

struct binding : @nodrop {
    _str& name;
    f64 value;
};

struct interpreter {
    lisp_node* program_body;
    usize program_length;
};

void interpreter::interpret(interpreter& this, lisp_node& node) {
    std::span(binding) locals = {
        .data = NULL,
        .length = 0
    };

    this |> interpreter::eval(node, locals);
}

void interpreter::register_program_functions(interpreter& this, lisp_node* body, usize body_length) {
    this.program_body = body;
    this.program_length = body_length;
}

f64 find_local(std::span(binding) locals, _str& name) {
    for (usize i = 0; i < locals.length; i++) {
        if (std::str::equals(locals.data[i].name, name)) {
            return locals.data[i].value;
        }
    }

    std::printf("Unknown symbol: %s\n", name);
    return 0.0;
}

lisp_node* interpreter::find_function(interpreter& this, _str& name) {
    for (usize i = 0; i < this.program_length; i++) {
        lisp_node* node = &this.program_body[i];
        match (node) {
            FnDef(auto& fn_def) => {
                if (std::str::equals(fn_def.name |> std::string::as_str(), name)) {
                    return node;
                }
            }
            _ => {}
        }
    }

    return NULL;
}

f64 interpreter::call_function(interpreter& this, _str& name, std::span(lisp_node) args, std::span(binding) locals) {
    lisp_node* fn_node = this |> interpreter::find_function(name);
    if (fn_node == NULL) {
        std::printf("Unknown function: %s\n", name);
        return 0.0;
    }

    f64 result = 0.0;
    match (fn_node) {
        FnDef(auto& fn_def) => {
            std::vector(binding) call_locals = std::vector::with_capacity(binding, fn_def.params.length);

            for (usize i = 0; i < fn_def.params.length; i++) {
                f64 arg_value = 0.0;
                if (i < args.length) {
                    arg_value = this |> interpreter::eval(args |>(1) std::span::at(_, i), locals);
                }

                binding local = {
                    .name = fn_def.params.data[i] |> std::string::as_str(),
                    .value = arg_value
                };
                std::vector::push(binding, call_locals, move local);
            }

            std::span(binding) call_local_span = {
                .data = call_locals.data,
                .length = call_locals.length
            };

            for (usize i = 0; i < fn_def.body.length; i++) {
                result = this |> interpreter::eval(fn_def.body.data[i], call_local_span);
            }

            std::vector::drop(binding, move call_locals);
        }
        _ => {}
    }

    return result;
}

f64 interpreter::eval(interpreter& this, lisp_node& node, std::span(binding) locals) {
    match (node) {
        Program(auto& body) => {
            this |> interpreter::register_program_functions(body.data, body.length);

            f64 result = 0.0;
            for (usize i = 0; i < body.length; i++) {
                result = this |> interpreter::eval(body.data[i], locals);
            }

            return result;
        }
        Number(auto num) => return num;
        Symbol(auto& name) => return find_local(locals, name |> std::string::as_str());
        FnDef(_) => return 0.0;
        FnCall(auto& fn_call) => {
            std::span(lisp_node) args = {
                .data = fn_call.args.data,
                .length = fn_call.args.length
            };

            return this |> interpreter::call_function(fn_call.name |> std::string::as_str(), args, locals);
        }
        Plus(auto& plus) => return (this |> interpreter::eval(*(plus.left.ptr), locals)) + (this |> interpreter::eval(*(plus.right.ptr), locals));
        Minus(auto& minus) => return (this |> interpreter::eval(*(minus.left.ptr), locals)) - (this |> interpreter::eval(*(minus.right.ptr), locals));
        PrintNum(auto& value) => {
            std::printf("%f\n", this |> interpreter::eval(*(value.ptr), locals));
            return 0.0;
        }
        PrintStr(auto& value) => {
            std::printf("%s\n", value |> std::string::as_str());
            return 0.0;
        }
    }

    return 0.0;
}
