import std::{io, panic, optional, span, string, functional} as std;

import std::net::{tcp, address} as std::net;

int main() {
    std::net::endpoint addr = std::net::endpoint::ipv4("0.0.0.0", 8080)
        |> std::opt::expect("Failed to create endpoint")!;
    std::net::tcp_server server = std::net::tcp_server::new()
        |> std::opt::expect("Failed to open socket")!;
    defer move server |> std::net::tcp_server::drop();

    server
        |> std::net::tcp_server::bind(move addr)
        |> std::opt::unwrap_or(emit .{
            std::panic("Failed to bind socket");
        })!;

    std::println("Server started on 127.0.0.1:8080");
    char buffer[1024];
    std::span(u8) buffer_span = std::span::new(buffer, 1024);

    while (1) {
        std::println("Waiting for client connection...");

        std::net::tcp_connection client = server |> std::net::tcp_server::accept()
            |> std::opt::unwrap_or(emit .{
                std::io::println("Failed to accept client");
                continue;
            })!;
        defer move client |> std::net::tcp_connection::drop();

        client |> std::net::tcp_connection::read(buffer_span)
            |> std::opt::unwrap_or(emit .{
                std::io::println("Failed to read request");
                continue;
            })!;

        std::println("Received request");

        std::span(const u8) response_buffer = std::str::as_const_bytes("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 48\r\nConnection: close\r\n\r\n<html><body><h1>Hello, world!</h1></body></html>");
        client |> std::net::tcp_connection::send(response_buffer)
            |> std::opt::unwrap_or(emit .{
                std::io::println("Failed to write response");
                continue;
            })!;
    }
}
