import std::{io, optional, result, memory::span, string, net::{tcp, address}} as std;

int main() {
    auto address = std::endpoint::ipv4("0.0.0.0", 8080) |> std::opt::expect("Invalid endpoint")!;
    auto server = std::tcp_server::new() |> std::result::expect("Could not open socket")!;
    defer std::tcp_server::drop(move server);

    std::tcp_server::bind(server, address) |> std::result::expect("Could not bind socket")!;
    std::println("Server listening on port 8080");
    u8 buffer[1024];

    while (true) {
        auto client = std::tcp_server::accept(server) |> std::result::unwrap_or(emit .{
            std::println("Could not accept client");
            continue;
        })!;
        defer std::tcp_connection::drop(move client);

        auto request = std::tcp_connection::read(client, std::span::new(buffer, sizeof(buffer)))
            |> std::result::unwrap_or(emit .{ continue; })!;
        if (request.length == 0) continue;

        auto response = std::str::as_const_bytes(
            "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 48\r\nConnection: close\r\n\r\n"
            "<html><body><h1>Hello, world!</h1></body></html>"
        );
        std::tcp_connection::send(client, response) |> std::result::unwrap_or(emit .{
            std::println("Could not send response");
            continue;
        })!;
    }
}
