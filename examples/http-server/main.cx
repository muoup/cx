import std::io as std;
import std::optional as std;
import std::span as std;
import std::string as std;
import std::functional as std;

import std::net::udp as std::net;

int main() {
    const _str& INDEX_HTML = "<html><body><h1>Hello, world!</h1></body></html>";

    std::net::endpoint addr = std::net::endpoint::ipv4("0.0.0.0", 8080)
        |> std::opt::unwrap_or_else(.{
            std::io::println("Failed to create endpoint");
            return 1;
        });

    std::net::udp_socket server = std::net::udp_socket::open()
        |> std::opt::unwrap_or_else(.{
            std::io::println("Failed to open socket");
            return 1;
        });

    server |> std::net::udp_socket::bind(addr)
        |> std::opt::unwrap_or_else(.{
            move server |> std::net::udp_socket::close();
            std::io::println("Failed to bind socket");
            return 1;
        });

    std::println("Server started on port 8080");

    char buffer[1024];

    while (1) {
        std::println("Waiting for client request...");

        std::net::udp::datagram result = server
            |> std::net::udp_socket::recv_from(buffer, 1023)
            |> std::opt::unwrap_or_else(.{
                std::io::println("Failed to receive data");
                continue;
            });

        std::println("Received request from client");

        std::span<const u8> response_buffer = std::span::str_as_bytes(INDEX_HTML);
        server |> std::net::udp_socket::send_to(response_buffer, result.source);
    }

    move server |> std::net::udp_socket::close();
}
