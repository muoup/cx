import std::box as std;
import std::vector as std;
import std::io as std;
import std::functional as std;

import ast as _;
import parser;

#include <stdlib.h>

public:

void interpret(lisp_node& node) {
    interpreter interpret = {
        .program_body = NULL,
        .program_length = 0
    };

    interpreter::interpreter::interpret(interpret, node);
}

void run(const char* source) {
    parser::parse(source)
        |> std::tap<ast::lisp_node>(interpret)
        |> lisp_node::drop;
}

private:

struct binding {
    char* name;
    f64 value;
};

struct interpreter {
    lisp_node* program_body;
    usize program_length;
};

bool str_eq(char* left, char* right) {
    usize i = 0;
    while (left[i] == right[i]) {
        if (left[i] == '\0') {
            return 1 == 1;
        }

        i++;
    }

    return 1 == 0;
}

void interpreter::interpret(interpreter& this, lisp_node& node) {
    this |> interpreter::eval(node, NULL, 0);
}

void interpreter::register_program_functions(interpreter& this, lisp_node* body, usize body_length) {
    this.program_body = body;
    this.program_length = body_length;
}

f64 find_local(binding* locals, usize local_count, char* name) {
    for (usize i = 0; i < local_count; i++) {
        if (str_eq(locals[i].name, name)) {
            return locals[i].value;
        }
    }

    printf("Unknown symbol: %s\n", name);
    return 0.0;
}

lisp_node* interpreter::find_function(interpreter& this, char* name) {
    for (usize i = 0; i < this.program_length; i++) {
        lisp_node* node = &this.program_body[i];
        match (node) {
            lisp_node::FnDef(fn_def) => {
                if (str_eq(fn_def.name.data, name)) {
                    return node;
                }
            }
            default => {}
        }
    }

    return NULL;
}

f64 interpreter::call_function(interpreter& this, char* name, lisp_node* args, usize arg_count, binding* locals, usize local_count) {
    lisp_node* fn_node = this |> interpreter::find_function(name);
    if (fn_node == NULL) {
        printf("Unknown function: %s\n", name);
        return 0.0;
    }

    f64 result = 0.0;
    match (fn_node) {
        lisp_node::FnDef(fn_def) => {
            binding* call_locals = malloc(fn_def.params.length * sizeof(binding));

            for (usize i = 0; i < fn_def.params.length; i++) {
                f64 arg_value = 0.0;
                if (i < arg_count) {
                    arg_value = this |> interpreter::eval(&args[i], locals, local_count);
                }

                call_locals[i].name = fn_def.params.data[i].data;
                call_locals[i].value = arg_value;
            }

            for (usize i = 0; i < fn_def.body.length; i++) {
                result = this |> interpreter::eval(&fn_def.body.data[i], call_locals, fn_def.params.length);
            }

            free(call_locals);
        }
        default => {}
    }

    return result;
}

f64 interpreter::eval(interpreter& this, lisp_node* node, binding* locals, usize local_count) {
    match (node) {
        lisp_node::Program(body) => {
            this |> interpreter::register_program_functions(body.data, body.length);

            f64 result = 0.0;
            for (usize i = 0; i < body.length; i++) {
                result = this |> interpreter::eval(&body.data[i], locals, local_count);
            }

            return result;
        }
        lisp_node::Number(num) => return num;
        lisp_node::Symbol(name) => return find_local(locals, local_count, name.data);
        lisp_node::FnDef(_) => return 0.0;
        lisp_node::FnCall(fn_call) => return this |> interpreter::call_function(fn_call.name.data, fn_call.args.data, fn_call.args.length, locals, local_count);
        lisp_node::Plus(plus) => return (this |> interpreter::eval(plus.left.ptr, locals, local_count)) + (this |> interpreter::eval(plus.right.ptr, locals, local_count));
        lisp_node::Minus(minus) => return (this |> interpreter::eval(minus.left.ptr, locals, local_count)) - (this |> interpreter::eval(minus.right.ptr, locals, local_count));
        lisp_node::PrintNum(value) => {
            printf("%f\n", this |> interpreter::eval(value.ptr, locals, local_count));
            return 0.0;
        }
        lisp_node::PrintStr(value) => {
            printf("%s\n", value);
            return 0.0;
        }
    }

    return 0.0;
}
