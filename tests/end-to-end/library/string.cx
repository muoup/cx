import std::string;
import std::optional;

#include <stdio.h>

int main() {
    std::string::string s = std::string::string::new();
    s |> std::string::string::append("Hello, worl");
    s |> std::string::string::append_char('d');
    s |> std::string::string::append_char('!');
    printf("%s\n", s.data);
    move s |> std::string::string::drop;
}
