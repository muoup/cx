import std::vector;
import std::optional;

#include <stdio.h>

int main() {
    std::vector::vector<int> vec = std::vector::vector::new<int>();
    
    vec.push<int>(1);
    vec.push<int>(2);
    vec.push<int>(3);

    printf("Vector length: %zu\n", vec.length);
    printf("Vector capacity: %zu\n", vec.capacity);
    
    std::optional::opt<int&> maybe_value = vec.at<int>(0);
    int value = maybe_value.unwrap<int&>();
    
    printf("vec[0]: %d\n", value);
    vec.drop<int>();
}
