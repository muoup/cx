import std::io as std;

struct IntWrapper { int x; };

IntWrapper IntWrapper::transform(IntWrapper wrapper) {
    wrapper.x += 1;
    return wrapper;
}

IntWrapper IntWrapper::new(int x) {
    return (IntWrapper) { x };
}

int main() {
    IntWrapper wrapper = IntWrapper::new(5)
        |> IntWrapper::transform();

    std::printf("Transformed IntWrapper: %d\n", wrapper.x);
}
