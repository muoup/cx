#include <stdio.h>
#include <stdlib.h>

struct rcell_int : @unsafe_move {
    int value;
    int sema;
};

struct rcell_guard : @nodrop {
    rcell_int* cell;
};

void rcell_release(rcell_guard guard) {
    guard.cell->sema = 0;
    printf("release %d\n", guard.cell->sema);
    @leak(guard);
}

void rcell_auto_release(rcell_int* cell) {
    cell->sema = 0;
    printf("release %d\n", cell->sema);
}

void rcell_require_available(rcell_int* cell) {
    if (cell->sema != 0) {
        printf("cell is already borrowed\n");
        exit(1);
    }
}

rcell_guard rcell_manual_borrow(rcell_int* cell) {
    rcell_require_available(cell);
    cell->sema = -1;
    printf("manual borrow %d\n", cell->sema);
    return (rcell_guard) { .cell = cell };
}

void manual_borrow_scope(rcell_int* cell) {
    rcell_guard guard = rcell_manual_borrow(cell);
    defer move guard |> rcell_release();
    printf("manual value %d\n", cell->value);
}

comptime expr void rcell_borrow(expr rcell_int* cell, expr(int&) void proc) {
    return emit .{
        rcell_require_available(cell);
        cell->sema = -1;
        printf("borrow %d\n", cell->sema);

        defer rcell_auto_release(cell);

        proc(cell->value);
    };
}

int rcell_read(rcell_int* cell) {
    cell |> rcell_borrow() <| |ref| then

    printf("read %d\n", ref);
    return ref;
}

void print_temporary(int value) {
    printf("temporary %d\n", value);
}

void rcell_print(rcell_int* cell) {
    cell |> rcell_borrow() <| |ref| print_temporary(ref);
    printf("temporary released %d\n", cell->sema);
}

int borrow_pair(rcell_int* lhs, rcell_int* rhs) {
    lhs |> rcell_borrow() <| |lhs_ref|
    rhs |> rcell_borrow() <| |rhs_ref| then

    printf("pair %d %d\n", lhs_ref, rhs_ref);
    return lhs_ref + rhs_ref;
}

int borrow_sequence(rcell_int* lhs, rcell_int* rhs) {
    lhs |> rcell_borrow() <| |lhs_ref| then

    printf("sequence lhs %d\n", lhs_ref);
    rhs |> rcell_borrow() <| |rhs_ref| then

    printf("sequence rhs %d\n", rhs_ref);
    return lhs_ref - rhs_ref;
}

void mark(int value) {
    printf("mark %d\n", value);
}

struct pair {
    int value;
};

void overwrite(pair* value) {
    value->value = 99;
}

pair preserved_return() {
    pair result = (pair) { .value = 5 };
    defer overwrite(&result);
    return result;
}

int nested_return() {
    defer mark(1);
    {
        defer mark(2);
        return 7;
    }
}

void loop_exits() {
    for (int i = 0; i < 3; i += 1) {
        defer mark(i + 10);
        if (i == 0) {
            continue;
        }
        if (i == 1) {
            break;
        }
    }
}

void scope_fallthrough() {
    {
        defer mark(3);
        mark(4);
    }
    mark(5);
}

void implicit_return() {
    defer mark(6);
    mark(7);
}

int match_yield() {
    return match (0) {
        0 => {
            defer mark(20);
            yield 8;
        }
        default => yield 9;
    };
}

void conditional_registration(bool enabled) {
    if (enabled) {
        defer mark(30);
        mark(31);
    }
    mark(32);
}

int main() {
    rcell_int cell = (rcell_int) { .value = 42, .sema = 0 };
    int value = rcell_read(&cell);
    printf("returned %d sema %d\n", value, cell.sema);
    rcell_print(&cell);

    rcell_int other = (rcell_int) { .value = 8, .sema = 0 };
    int pair_value = borrow_pair(&cell, &other);
    printf("pair returned %d semas %d %d\n", pair_value, cell.sema, other.sema);
    int sequence_value = borrow_sequence(&cell, &other);
    printf("sequence returned %d semas %d %d\n", sequence_value, cell.sema, other.sema);
    manual_borrow_scope(&cell);
    printf("manual released %d\n", cell.sema);

    printf("nested %d\n", nested_return());
    loop_exits();
    scope_fallthrough();
    implicit_return();
    printf("yielded %d\n", match_yield());
    conditional_registration(1);
    conditional_registration(0);
    pair result = preserved_return();
    printf("preserved %d\n", result.value);
    return 0;
}
