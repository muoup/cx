#include <stdio.h>

void trace_leave(int value) {
    printf("leave %d\n", value);
}

comptime expr void with_trace(expr int& value, expr(int&) void proc) {
    return emit .{
        printf("enter %d\n", value);
        defer trace_leave(value);
        proc(value);
    };
}

void single_expression() {
    int source = 4;
    with_trace(source) <| |value| .{
        value += 1;
    };
    printf("single complete\n");
}

int return_from_continuation() {
    int source = 7;
    with_trace(source) <| |value| then

    printf("return body %d\n", value);
    return value + 1;
}

int nested_continuations() {
    int left_source = 20;
    int right_source = 22;
    with_trace(left_source) <| |left|
    with_trace(right_source) <| |right| then

    printf("nested sum %d\n", left + right);
    return left + right;
}

int main() {
    single_expression();
    printf("returned %d\n", return_from_continuation());
    printf("nested returned %d\n", nested_continuations());
    return 0;
}
