#include <stdio.h>

import std::optional as std;

std::opt<int> add_optional_pair(std::opt<int> lhs, std::opt<int> rhs) {
    int lhs_value = lhs |> std::opt::try();
    int rhs_value = rhs |> std::opt::try();

    return std::opt::some<int>(lhs_value + rhs_value);
}

void print_result(const char* label, std::opt<int> value) {
    match (value) {
        std::opt::some<int>(inner) => printf("%s some %d\n", label, inner);
        std::opt::none<int>() => printf("%s none\n", label);
    }
}

int main() {
    print_result("both", add_optional_pair(std::opt::some<int>(20), std::opt::some<int>(22)));
    print_result("left", add_optional_pair(std::opt::none<int>(), std::opt::some<int>(22)));
    print_result("right", add_optional_pair(std::opt::some<int>(20), std::opt::none<int>()));
}
