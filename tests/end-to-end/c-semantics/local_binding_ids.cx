#include <stdio.h>

struct Resource : @nodrop {
    int data;
};

void Resource::drop(Resource this) {
    printf("drop %d\n", this.data);
    @leak(this);
}

void shadow_parameter(int value) {
    if (value > 0) {
        int value = 30;
        printf("inner parameter %d\n", value);
    }

    printf("outer parameter %d\n", value);
}

int main() {
    int value = 10;

    if (value > 0) {
        int value = 20;
        printf("inner local %d\n", value);
    }

    printf("outer local %d\n", value);
    shadow_parameter(value);

    Resource resource = (Resource) {
        .data = 40
    };
    if (value > 0) {
        Resource resource = (Resource) {
            .data = 50
        };
        move resource |> Resource::drop();
    }
    move resource |> Resource::drop();

    return 0;
}
