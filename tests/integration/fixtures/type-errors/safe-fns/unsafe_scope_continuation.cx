struct pinned : @unsafe_move {
    int value;
};

struct holder {
    pinned inner;
    int tag;
};

void select(int cond) safe {
    pinned first = (pinned) {
        .value = 1
    };
    pinned second = (pinned) {
        .value = 2
    };
    holder h = cond ? @unsafe({ .inner = move first, .tag = 1 }) : ({ .inner = move second, .tag = 2 });
}

int main() {
    select(1);
    return 0;
}
