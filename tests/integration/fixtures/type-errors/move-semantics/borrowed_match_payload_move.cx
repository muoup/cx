struct Resource : @nocopy {
    int data;
};

enum union Choice : @nocopy {
    none :: void,
    some :: Resource
};

Resource read(Choice& value) {
    match (value) {
        some(auto& inner) => return move inner,
        none() => return (Resource) { .data = 0 },
    }
}

int main() {
    return 0;
}
