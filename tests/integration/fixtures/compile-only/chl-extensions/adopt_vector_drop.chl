import std::collections::vector;

struct Resource : @nodrop {
    int data;
};

void destroy(Resource value) {
    @leak(value);
}

int main() {
    std::collections::vector::vector(Resource) values = std::collections::vector::vector::new(Resource);
    Resource value = (Resource) {
        .data = 11
    };

    values |> std::collections::vector::vector::push(move value);
    move values |> std::collections::vector::vector::drop_with(destroy);
    return 0;
}
