struct Resource : @nodrop {
    int data;
};

enum union MaybeResource : @nodrop {
    none :: void,
    some :: Resource
};

void Resource::drop(Resource this) safe {
    @unsafe {
        @leak(this);
    };
}

int main() {
    MaybeResource maybe = MaybeResource::some((Resource) {
        .data = 1
    });
    match (move maybe) {
        some(auto inner) => {
            move inner |> Resource::drop();
        }
        none() => {}
    }
    return 0;
}
