import std::{memory::span, net::{address, udp, error}, optional, result, string} as std;

std::result(std::udp_socket, std::socket_error) try_serve(u16 port) {
    auto address = std::endpoint::ipv4("0.0.0.0", port) |> std::opt::unwrap();
    auto socket = std::udp_socket::open() |> std::result::try()!;

    std::udp_socket::bind(socket, address) |> std::result::try()!;
    auto buffer = std::str::as_const_bytes("Hello, world!");
    std::udp_socket::send_to(socket, buffer, address) |> std::result::try_or(emit .{
        std::udp_socket::close(move socket);
    })!;
    return _::ok(move socket);
}
