import _template_names_a as a;
import _template_names_a as again;
import _template_names_b as b;

#include <stdio.h>

T value(@type T, T input) {
    return input + 3;
}

comptime expr(T) staged(@type T, expr(T) input) {
    return emit input;
}

int main() {
    int (*first)(int) = a::value(int);
    int (*second)(int) = b::value(int);
    int (*local)(int) = value(int);
    a::Box(int) box = { 7 };
    printf("%d %d %d %d %d\n", first(10), second(10), local(10),
        again::value(_, 10), box |>(1) a::Box::read(int));
    printf("%d %d %d\n", a::staged(int, emit 21), b::staged(int, emit 22), staged(int, emit 23));
    return 0;
}
