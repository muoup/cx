comptime int module_bias = 4;

int private_step(int value) {
    return value + module_bias;
}

public:
comptime int add_module_bias(int value) {
    return private_step(value);
}

comptime @type integer_type() => int;

comptime @type Box(comptime @type T) => struct { T value; };
comptime Box(T) make_box(comptime @type T, T value) => { .value = private_step(value) };

T runtime_bias(comptime @type T, T value) => private_step(value);
T runtime_forward(comptime @type T, T value) => runtime_bias(T, value);
