/* CHL-STDOUT: cleanup 11 */
/* CHL-STDOUT-NEXT: body 2 */
/* CHL-STDOUT-NEXT: cleanup 12 */

#include <stdio.h>

void run(int value) {
    defer .{
        int cleanup_value = value + 10;
        printf("cleanup %d\n", cleanup_value);
    };

    if (value == 1) return;
    printf("body %d\n", value);
}

int main() {
    run(1);
    run(2);
    return 0;
}
