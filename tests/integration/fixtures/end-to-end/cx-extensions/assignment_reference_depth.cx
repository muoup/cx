/* CX-STDOUT: 9 2 2 3 4 */
#include <stdio.h>
struct Pair { int left; int right; };
int main() {
    int a = 1;
    int b = 2;
    int& r = a;
    r = (r = b, 9);
    Pair pair = { 0, 0 };
    Pair& ref = pair;
    ref = { 3, 4 };
    printf("%d %d %d %d %d\n", a, b, r, pair.left, pair.right);
    return 0;
}
