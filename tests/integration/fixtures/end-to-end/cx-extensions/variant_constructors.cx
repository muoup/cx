/* CX-STDOUT: circle 0 3 0.00 */
/* CX-STDOUT-NEXT: empty 2 0 0.00 */
/* CX-STDOUT-NEXT: alias 1 0 2.50 */
/* CX-STDOUT-NEXT: stored 0 7 0.00 */
/* CX-STDOUT-NEXT: stored-empty 2 0 0.00 */
/* CX-STDOUT-NEXT: designated 1 0 1.50 */
/* CX-STDOUT-NEXT: coerced 1 0 10.00 */
/* CX-STDOUT-NEXT: calls 2 */
/* CX-STDOUT-NEXT: maybe 0 1 5 */
/* CX-STDOUT-NEXT: identity 1 1 1 0 */

#include <stdio.h>
#include <string.h>

enum union Shape {
    circle :: int,
    square :: double,
    empty :: void
};

typedef Shape Figure;
typedef void nothing;

enum union Maybe {
    none :: nothing,
    some :: int
};

int calls = 0;

int next() {
    calls++;
    return calls * 10;
}

void show(const char* label, Shape value) {
    unsigned char* bytes = (unsigned char*)&value;
    int integer;
    double real;
    memcpy(&integer, bytes, sizeof(integer));
    memcpy(&real, bytes, sizeof(real));
    printf("%s %d %d %.2f\n", label, bytes[8], integer, real);
}

int maybe_tag(Maybe value) {
    unsigned char* bytes = (unsigned char*)&value;
    return bytes[4];
}

int main() {
    show("circle", Shape::circle(3));
    show("empty", Shape::empty());
    Figure alias = Figure::square(2.5);
    show("alias", alias);

    Shape (*make)(int) = Shape::circle;
    show("stored", make(7));
    Shape (*vacant)() = Shape::empty;
    show("stored-empty", vacant());

    Shape designated = { .square = 1.5 };
    show("designated", designated);

    show("coerced", Shape::square(next()));
    Shape (*real)(double) = Shape::square;
    Shape once = real(next());
    printf("calls %d\n", calls);

    Maybe none = Maybe::none();
    Maybe some = Maybe::some(5);
    unsigned char* bytes = (unsigned char*)&some;
    int payload;
    memcpy(&payload, bytes, sizeof(payload));
    printf("maybe %d %d %d\n", maybe_tag(none), maybe_tag(some), payload);

    printf("identity %d %d %d %d\n",
        Shape::circle == Shape::circle,
        make == Figure::circle,
        vacant == Shape::empty,
        (void*)Shape::circle == (void*)Shape::square);
    return 0;
}
