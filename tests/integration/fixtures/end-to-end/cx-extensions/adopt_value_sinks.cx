/* CX-STDOUT: 1 2 3 4 5 */
#include <stdio.h>
#include <stdlib.h>
struct Resource : @nodrop { int value; };
struct Holder : @nodrop { Resource value; };
void consume(Resource value) { printf("%d ", value.value); @leak(value); }
Resource forward(Resource& value) { return @unsafe(@adopt(@copy(value))); }
int main() {
    Resource* a = malloc(sizeof(Resource));
    Resource* b = malloc(sizeof(Resource));
    Resource* c = malloc(sizeof(Resource));
    Resource* d = malloc(sizeof(Resource));
    Resource* e = malloc(sizeof(Resource));
    *a = (Resource){ .value = 1 };
    *b = (Resource){ .value = 2 };
    *c = (Resource){ .value = 3 };
    *d = (Resource){ .value = 4 };
    *e = (Resource){ .value = 5 };
    int choose = 1;
    consume(choose ? @unsafe(@adopt(*a)) : @unsafe(@adopt(*b)));
    consume(forward(*b));
    Resource value = @unsafe(@adopt(*c));
    printf("%d ", value.value);
    @unsafe(@leak(value));
    Resource assigned;
    assigned = @unsafe(@adopt(*d));
    printf("%d ", assigned.value);
    @unsafe(@leak(assigned));
    Holder holder = (Holder){ .value = @unsafe(@adopt(*e)) };
    printf("%d\n", holder.value.value);
    @unsafe(@leak(holder));
    free(a); free(b); free(c); free(d); free(e);
    return 0;
}
