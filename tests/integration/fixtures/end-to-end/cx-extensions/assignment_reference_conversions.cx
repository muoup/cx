/* CX-STDOUT: 4 5 1 */
#include <stdio.h>
typedef int (*Function)(void);
int value() { return 5; }
int main() {
    int x = 4;
    int* p = &x;
    void* raw = 0;
    void*& ref = raw;
    ref = p;
    int* restored = 0;
    int*& restored_ref = restored;
    restored_ref = raw;
    int values[] = { 4, 8 };
    restored_ref = values;
    int* empty = p;
    int*& null_ref = empty;
    null_ref = 0;
    Function function = value;
    Function& fn_ref = function;
    fn_ref = value;
    printf("%d %d %d\n", *restored, function(), empty == 0);
    return 0;
}
