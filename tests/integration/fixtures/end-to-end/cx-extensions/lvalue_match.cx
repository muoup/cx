/* CX-STDOUT: 9 2 40 */
import std::optional;
#include <stdio.h>
int main() {
    int x = 1;
    int y = 2;
    std::optional::opt(int) flag = std::optional::opt(int)::some(1);
    auto selected = match (flag) {
        some(_) => x,
        none() => y,
    };
    selected = 9;
    auto copied = match (flag) {
        some(auto value) => value,
        none() => y,
    };
    copied = 40;
    printf("%d %d %d\n", x, y, copied);
    return 0;
}
