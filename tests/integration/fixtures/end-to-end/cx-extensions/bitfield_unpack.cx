/* CX-STDOUT: unpack 5 17 -3 9 */
#include <stdio.h>

struct flags {
    u32 low : 3;
    u32 high : 5;
    i32 delta : 4;
    i32 value;
};

int main() {
    flags packed = { .low = 13, .high = 17, .delta = -3, .value = 9 };
    @unpack(move packed) {
        low: low,
        high: high,
        delta: delta,
        value: value,
    };
    printf("unpack %d %d %d %d\n", low, high, delta, value);
    return 0;
}
