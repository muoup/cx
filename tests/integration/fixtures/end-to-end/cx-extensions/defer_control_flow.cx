#include <stdio.h>

void mark(int value) {
    printf("mark %d\n", value);
}

void same_scope_lifo() {
    defer mark(1);
    defer mark(2);
    mark(0);
}

int nested_return() {
    defer mark(3);
    {
        defer mark(4);
        return 7;
    }
}

void loop_exits() {
    for (int i = 0; i < 3; i += 1) {
        defer mark(i + 10);
        if (i == 0) {
            continue;
        }
        if (i == 1) {
            break;
        }
    }
}

void nested_fallthrough() {
    {
        defer mark(20);
        mark(21);
    }
    mark(22);
}

void implicit_return() {
    defer mark(30);
    mark(31);
}

struct result {
    int value;
};

void overwrite(result* value) {
    value->value = 99;
}

result preserve_return_value() {
    result value = (result) { .value = 5 };
    defer overwrite(&value);
    return value;
}

int main() {
    same_scope_lifo();
    printf("returned %d\n", nested_return());
    loop_exits();
    nested_fallthrough();
    implicit_return();

    result value = preserve_return_value();
    printf("preserved %d\n", value.value);
    return 0;
}
