/* CX-STDOUT: 12 1 */
/* CX-STDOUT-NEXT: 21 1 */
/* CX-STDOUT-NEXT: 1 2 */
/* CX-STDOUT-NEXT: 1 2 */

#include <stdio.h>

int values[4] = {3, 5, 7, 11};
int order = 0;

int offset(void) {
    order = order * 10 + 1;
    return 1;
}

int *pointer(void) {
    order = order * 10 + 2;
    return values;
}

int main(void) {
    int *first = offset() + pointer();
    printf("%d %d\n", order, (int) (first - values));
    order = 0;
    int *second = pointer() + offset();
    printf("%d %d\n", order, (int) (second - values));
    int index = 1;
    int *third = index + (index = 2, values);
    printf("%d %d\n", (int) (third - values), index);
    int *base = values;
    int *fourth = base + (base = values + 2, 1);
    printf("%d %d\n", (int) (fourth - values), (int) (base - values));
    return 0;
}
