/* CX-STDOUT: 98 */

#include <stdio.h>

struct cursor {
    const _str& source;
    usize position;
};

int cursor::peek(cursor& this) {
    return this.source[this.position];
}

int main() {
    cursor value = {
        .source = "abc",
        .position = 1
    };

    printf("%d\n", value |> cursor::peek());
    return 0;
}
