/* CX-STDOUT: ref access 42 */
/* CX-STDOUT-NEXT: ptr access 42 */
/* CX-STDOUT-NEXT: ref match 42 */
/* CX-STDOUT-NEXT: ptr match 42 */
/* CX-STDOUT-NEXT: ptr match none -1 */
/* CX-STDOUT-NEXT: ptr is 10 */
/* CX-STDOUT-NEXT: ptr is none -1 */

#include <stdio.h>

struct Point {
    int x;
    int y;
};

enum union MaybePoint {
    none :: void,
    some :: Point
};

int read_point_ref(Point& value) {
    return value.x + value.y;
}

int read_point_ptr(Point* value) {
    return value.x + value.y;
}

int match_point_ref(MaybePoint& value) {
    return match (value) {
        MaybePoint::some(point) => yield point.x + point.y;
        MaybePoint::none() => yield -1;
    };
}

int match_point_ptr(MaybePoint* value) {
    return match (value) {
        MaybePoint::some(point) => yield point.x + point.y;
        MaybePoint::none() => yield -1;
    };
}

int is_point_ptr(MaybePoint* value) {
    if (value is MaybePoint::some(point)) {
        return point.x;
    }

    return -1;
}

int main() {
    Point point = (Point) { .x = 10, .y = 32 };
    MaybePoint some = MaybePoint::some(point);
    MaybePoint none = MaybePoint::none();

    printf("ref access %d\n", read_point_ref(point));
    printf("ptr access %d\n", read_point_ptr(&point));
    printf("ref match %d\n", match_point_ref(some));
    printf("ptr match %d\n", match_point_ptr(&some));
    printf("ptr match none %d\n", match_point_ptr(&none));
    printf("ptr is %d\n", is_point_ptr(&some));
    printf("ptr is none %d\n", is_point_ptr(&none));
}
