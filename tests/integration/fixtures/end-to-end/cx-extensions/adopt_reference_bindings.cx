/* CX-STDOUT: 2 3 4 */
#include <stdio.h>
struct Pair { int value; };
struct Holder { Pair& reference; };
void update(Pair& value) { value.value = 3; }
int main() {
    Pair source = { 1 };
    Pair& borrowed = @unsafe(@adopt(source));
    borrowed.value = 2;
    int first = source.value;
    update(@unsafe(@adopt(source)));
    int second = source.value;
    Holder holder = { .reference = @unsafe(@adopt(source)) };
    holder.reference.value = 4;
    printf("%d %d %d\n", first, second, source.value);
    return 0;
}
