#include <stdio.h>
import std::optional as std;

comptime expr(void) yield_none() {
    return emit .{ yield _::none(); };
}

comptime expr(void) forward_yield() {
    return yield_none();
}

int main() {
    std::opt(int) integer = match (1) {
        0 => yield std::opt(int)::some(1);
        _ => {
            forward_yield();
            yield std::opt(int)::some(1);
        }
    };
    std::opt(float) floating = match (1) {
        0 => yield std::opt(float)::some(1.0f);
        _ => {
            forward_yield();
            yield std::opt(float)::some(1.0f);
        }
    };
    match (move integer) {
        none() => printf("integer none\n");
        some(auto value) => printf("integer some\n");
    }
    match (move floating) {
        none() => printf("float none\n");
        some(auto value) => printf("float some\n");
    }
    return 0;
}
