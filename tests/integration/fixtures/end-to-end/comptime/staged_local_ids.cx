/* CX-STDOUT: enter 20 */
/* CX-STDOUT-NEXT: enter 22 */
/* CX-STDOUT-NEXT: sum 42 */
/* CX-STDOUT-NEXT: leave 22 */
/* CX-STDOUT-NEXT: leave 20 */
/* CX-STDOUT-NEXT: returned 42 */

#include <stdio.h>

void leave_generated(int value) {
    printf("leave %d\n", value);
}

comptime expr(void) with_generated_local(expr(int) initial, @fn proc(expr(int&)) -> expr(void)) {
    return emit .{
        int staged_value = initial;
        printf("enter %d\n", staged_value);
        defer leave_generated(staged_value);
        proc(staged_value);
    };
}

int nested_generated_locals() {
    with_generated_local(emit 20) <| |left| emit
    with_generated_local(emit 22) <| |right| then

    printf("sum %d\n", left + right);
    return left + right;
}

int main() {
    printf("returned %d\n", nested_generated_locals());
    return 0;
}
