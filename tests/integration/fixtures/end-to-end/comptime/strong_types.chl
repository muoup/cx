/* CHL-STDOUT: 1 1 1 1 */
/* CHL-STDOUT-NEXT: 1 1 1 1 */
/* CHL-STDOUT-NEXT: 4 1 8 */
/* CHL-STDOUT-NEXT: 1 1 1 1 */
#include <stdio.h>
import std::vector as std;

typedef @strong int meters;
typedef meters distance;
typedef @strong int seconds;

comptime type record(type T) = struct { T value; };
comptime type ignored(type T) = struct { int value; };
comptime type payload(type T) = @strong struct { int value; };
comptime type legacy(type T) => struct { int value; };
comptime type boxed(type T) => .{ yield @strong struct { int value; }; };
comptime type Node(type T) => @strong struct { Node(T)* next; T value; };
comptime type scalar(type T) = @strong int;
comptime type compound(type T) = struct { @strong int tag; T value; };
struct Data;
typedef @strong struct Data StrongData;
struct Data { int value; };

int width(comptime type T = _, record(T)* value) => (int)sizeof(T);
int argument_width(comptime type T = _, payload(T)* value) => (int)sizeof(T);

int main() {
    meters m = (meters)3;
    distance d = m + (meters)1;
    struct { int value; } anonymous = { .value = 2 };
    Node(int) tail = { .value = 1 };
    Node(int) head = { .next = &tail, .value = 0 };
    payload(long)* p = (payload(long)*)0;
    printf("%d %d %d %d\n", !@type.equal(meters, int), @type.equal(meters, distance),
        !@type.equal(meters, seconds), !@type.equal(std::vector(int), std::vector(meters)));
    printf("%d %d %d %d\n", @type.equal(ignored(int), ignored(float)),
        !@type.equal(payload(int), payload(float)), !@type.equal(legacy(int), legacy(float)),
        !@type.equal(boxed(int), boxed(float)));
    printf("%d %d %d\n", (int)d, width(&anonymous) == sizeof(int) && head.next->value == 1, argument_width(p));
    const meters qualified = m;
    StrongData data = { .value = 1 };
    printf("%d %d %d %d\n", @type.equal(@type.unqualify(const meters), meters),
        !@type.equal(scalar(int), scalar(float)), (int)qualified == 3 && data.value == 1,
        @type.equal(compound(int), compound(int)));
    return 0;
}
