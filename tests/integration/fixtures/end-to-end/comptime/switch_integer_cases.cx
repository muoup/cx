#include <stdio.h>

i32 signed_case(i32 value) {
    switch (value) {
        case -1: return 1;
        case 0 - 2: return 2;
        case -2147483647 - 1: return 3;
        case 2147483647: return 4;
        case 7: return 5;
        default: return 0;
    }
}

i32 unsigned_case(u64 value) {
    switch (value) {
        case 4294967295ULL: return 6;
        case 1ULL << 63: return 7;
        case ~0ULL: return 8;
        case 0: return 9;
        default: return 0;
    }
}

comptime i32 signed_case_ct(i32 value) {
    switch (value) {
        case -1: return 1;
        case 0 - 2: return 2;
        case -2147483647 - 1: return 3;
        case 2147483647: return 4;
        case 7: return 5;
        default: return 0;
    }
}

comptime i32 unsigned_case_ct(u64 value) {
    switch (value) {
        case 4294967295ULL: return 6;
        case 1ULL << 63: return 7;
        case ~0ULL: return 8;
        case 0: return 9;
        default: return 0;
    }
}

int main() {
    printf("%d %d %d %d %d %d\n",
        signed_case(-1), signed_case(-2), signed_case(-2147483647 - 1),
        signed_case(2147483647), signed_case(7), signed_case(0));
    printf("%d %d %d %d %d\n",
        unsigned_case(4294967295ULL), unsigned_case(1ULL << 63),
        unsigned_case(~0ULL), unsigned_case(0), unsigned_case(1));
    printf("%d %d %d %d %d %d\n",
        signed_case_ct(0 - 1), signed_case_ct(0 - 2), signed_case_ct(-2147483647 - 1),
        signed_case_ct(2147483647), signed_case_ct(7), signed_case_ct(0));
    printf("%d %d %d %d %d\n",
        unsigned_case_ct(4294967295ULL), unsigned_case_ct(1ULL << 63),
        unsigned_case_ct(~0ULL), unsigned_case_ct(0), unsigned_case_ct(1));
    return 0;
}
