#include <stdio.h>

comptime type Defaulted(comptime int N = 2) => struct { int data[N]; };
comptime type Scalar() = int;
comptime type Alias() = Scalar;
comptime type Array(comptime int N = _) = int[N];
comptime type Box(comptime type T) => struct { T value; };

Defaulted identity(Defaulted value) => value;
usize length(Array& value) => sizeof(value) / sizeof(int);
usize boxed_length(Box(Array)& value) => length(value.value);

int main() {
    Defaulted implicit = { .data = { 17 } };
    Defaulted() explicit = identity(implicit);
    Defaulted(.N = 3) override;
    const Defaulted* pointer = &explicit;
    Box(Defaulted) boxed = { .value = explicit };
    Alias scalar = (Scalar) pointer->data[0];
    int array[4];
    Array inferred = array;
    Box(Array(.N = 4)) boxed_array;
    bool callable = !@type.equal(@type.type_of(Scalar), Scalar);
    printf("%d %d %d %d %d %d %d\n", scalar, boxed.value.data[0],
           (int)(sizeof(override.data) / sizeof(int)), (int)length(array), (int)length(inferred),
           (int)boxed_length(boxed_array), (int)callable);
    return 0;
}
