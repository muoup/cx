#include <stdio.h>

comptime expr T twice<T>(expr T value) {
    return emit value * 2;
}

comptime expr T add_ten<T>(expr T value) {
    return emit value + 10;
}

int main() {
    int value = twice<int>(21);
    int chained = add_ten<int>(twice<int>(4));

    printf("value %d\n", value);
    printf("chained %d\n", chained);
}
