#include <stdio.h>

import std::optional as std;

comptime expr(void) make_none() {
    return emit .{
        return _::none();
    };
}

comptime expr(void) forward_none() {
    return make_none();
}

std::opt(int) int_result() {
    forward_none();
    return std::opt(int)::some(123);
}

std::opt(float) float_result() {
    forward_none();
    return std::opt(float)::some(4.5);
}

int main() {
    std::opt(int) first = int_result();
    std::opt(int) second = int_result();
    std::opt(float) third = float_result();
    match (first) {
        some(auto value) => printf("int some %d\n", value);
        none() => printf("int none\n");
    }
    match (second) {
        some(auto value) => printf("int repeat some %d\n", value);
        none() => printf("int repeat none\n");
    }
    match (third) {
        some(auto value) => printf("float some %.1f\n", value);
        none() => printf("float none\n");
    }
}
