/* CX-STDOUT: 11 5 5 */

#include <stdio.h>

comptime ^void with(^int& v, fn body(^int&) -> ^void) =>
    emit .{ body(v); };

comptime ^int apply(fn f(^int, ^int) -> ^int, ^int a, ^int b) =>
    emit f(a, b);

int main() {
    int x = 10;
    with(emit x, |^int& v| emit .{ v += 1; });
    int d = apply(|a, b| emit a - b, emit 8, emit 3);
    int output = 0;
    int& reference = output;
    reference = apply(|a, b| emit a - b, emit 8, emit 3);
    printf("%d %d %d\n", x, d, output);
    return 0;
}
