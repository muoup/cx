/* CX-STDOUT: staged pair 42 */

#include <stdio.h>

comptime expr(void) invoke_pair(
    expr(int&) lhs,
    expr(int&) rhs,
    @fn proc(expr(int&), expr(int&)) -> expr(void)
) {
    return emit .{
        proc(lhs, rhs);
    };
}

void store_sum(int* output, int lhs, int rhs) {
    *output = lhs + rhs;
}

int main() {
    int lhs = 20;
    int rhs = 22;
    int result = 0;

    invoke_pair(emit lhs, emit rhs) <| |left, right| emit store_sum(&result, left, right);

    printf("staged pair %d\n", result);
    return 0;
}
