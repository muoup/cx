/* CX-STDOUT: staged pair 42 */

#include <stdio.h>

comptime ^void invoke_pair(
    ^int& lhs,
    ^int& rhs,
    fn proc(^int&, ^int&) -> ^void
) {
    return emit .{
        proc(lhs, rhs);
    };
}

void store_sum(int* output, int lhs, int rhs) {
    *output = lhs + rhs;
}

int main() {
    int lhs = 20;
    int rhs = 22;
    int result = 0;

    invoke_pair(emit lhs, emit rhs) <| |left, right| => store_sum(&result, left, right);

    printf("staged pair %d\n", result);
    return 0;
}
