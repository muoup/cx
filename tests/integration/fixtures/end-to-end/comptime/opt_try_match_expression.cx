/* CX-STDOUT: a some 42 */
/* CX-STDOUT-NEXT: b none */

#include <stdio.h>

import std::optional as std;

enum union Choice {
    a :: int,
    b :: void
};

std::opt<int> choose_optional(Choice choice) {
    match (choice) {
        Choice::a(value) => return std::opt::some<int>(value);
        Choice::b() => return std::opt::none<int>();
    }
}

std::opt<int> add_three(Choice choice) {
    int value = choose_optional(choice) |> std::opt::try();

    return std::opt::some<int>(value + 3);
}

void print_result(const char* label, std::opt<int> value) {
    match (value) {
        std::opt::some<int>(inner) => printf("%s some %d\n", label, inner);
        std::opt::none<int>() => printf("%s none\n", label);
    }
}

int main() {
    print_result("a", add_three(Choice::a(39)));
    print_result("b", add_three(Choice::b()));
}
