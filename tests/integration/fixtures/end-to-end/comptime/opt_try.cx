/* CX-STDOUT: some 42 */
/* CX-STDOUT-NEXT: none */

#include <stdio.h>

import std::optional as std;

std::opt(int) maybe_add_one(std::opt(int) value) {
    int inner = value |>(1) std::opt::try(_);

    return std::opt(int)::some(inner + 1);
}

int main() {
    std::opt(int) some = maybe_add_one(std::opt(int)::some(41));
    std::opt(int) none = maybe_add_one(std::opt(int)::none());

    match (some) {
        some(auto value) => printf("some %d\n", value);
        none() => printf("unexpected none\n");
    }

    match (none) {
        some(auto value) => printf("unexpected some %d\n", value);
        none() => printf("none\n");
    }
}
