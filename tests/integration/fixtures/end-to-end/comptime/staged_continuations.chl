/* CHL-STDOUT: enter 4 */
/* CHL-STDOUT-NEXT: leave 5 */
/* CHL-STDOUT-NEXT: single complete */
/* CHL-STDOUT-NEXT: enter 7 */
/* CHL-STDOUT-NEXT: return body 7 */
/* CHL-STDOUT-NEXT: leave 7 */
/* CHL-STDOUT-NEXT: returned 8 */
/* CHL-STDOUT-NEXT: enter 20 */
/* CHL-STDOUT-NEXT: enter 22 */
/* CHL-STDOUT-NEXT: nested sum 42 */
/* CHL-STDOUT-NEXT: leave 22 */
/* CHL-STDOUT-NEXT: leave 20 */
/* CHL-STDOUT-NEXT: nested returned 42 */

#include <stdio.h>

void trace_leave(int value) {
    printf("leave %d\n", value);
}

comptime ^void with_trace(^int& value, fn proc(^int&) -> ^void) {
    return emit .{
        printf("enter %d\n", value);
        defer trace_leave(value);
        proc(value);
    };
}

void single_expression() {
    int source = 4;
    with_trace(emit source) <| |auto value| {
        value += 1;
    };
    printf("single complete\n");
}

int return_from_continuation() {
    int source = 7;
    with_trace(emit source)! <| |auto value| then

    printf("return body %d\n", value);
    return value + 1;
}

int nested_continuations() {
    int left_source = 20;
    int right_source = 22;
    with_trace(emit left_source)! <| |auto left| =>
    with_trace(emit right_source) <| |auto right| then

    printf("nested sum %d\n", left + right);
    return left + right;
}

int main() {
    single_expression();
    printf("returned %d\n", return_from_continuation());
    printf("nested returned %d\n", nested_continuations());
    return 0;
}
