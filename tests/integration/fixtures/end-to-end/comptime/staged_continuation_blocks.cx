/* CX-STDOUT: enter 1 */
/* CX-STDOUT-NEXT: call form 1 */
/* CX-STDOUT-NEXT: leave 1 */
/* CX-STDOUT-NEXT: enter 2 */
/* CX-STDOUT-NEXT: inner 2 */
/* CX-STDOUT-NEXT: leave 2 */
/* CX-STDOUT-NEXT: after inner */
/* CX-STDOUT-NEXT: enter 3 */
/* CX-STDOUT-NEXT: leave 3 */
/* CX-STDOUT-NEXT: enter 4 */
/* CX-STDOUT-NEXT: between 4 */
/* CX-STDOUT-NEXT: enter 5 */
/* CX-STDOUT-NEXT: sum 9 */
/* CX-STDOUT-NEXT: leave 5 */
/* CX-STDOUT-NEXT: leave 4 */

#include <stdio.h>

void trace_leave(int value) {
    printf("leave %d\n", value);
}

comptime expr void with_trace(expr int& value, expr(int&) void proc) {
    return emit .{
        printf("enter %d\n", value);
        defer trace_leave(value);
        proc(value);
    };
}

void call_form() {
    int source = 1;
    with_trace(source, |value| then);
    printf("call form %d\n", value);
}

void inner_block() {
    int source = 2;
    {
        with_trace(source) <| |value| then
        printf("inner %d\n", value);
    }
    printf("after inner\n");
}

void at_block_end() {
    int source = 3;
    with_trace(source) <| |value| then
}

void sequential() {
    int left_source = 4;
    int right_source = 5;
    with_trace(left_source) <| |left| then
    printf("between %d\n", left);
    with_trace(right_source) <| |right| then
    printf("sum %d\n", left + right);
}

int main() {
    call_form();
    inner_block();
    at_block_end();
    sequential();
    return 0;
}
