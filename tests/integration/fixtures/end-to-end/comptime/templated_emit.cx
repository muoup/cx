#include <stdio.h>

comptime expr T pass<T>(expr T value) {
    return emit value;
}

comptime expr T choose_first<T>(expr T lhs, expr T rhs) {
    return emit lhs;
}

int main() {
    int int_value = pass<int>(37);
    float float_value = pass<float>(4.5);
    int selected = choose_first<int>(9, 100);

    printf("int %d\n", int_value);
    printf("float %.1f\n", float_value);
    printf("selected %d\n", selected);
}
