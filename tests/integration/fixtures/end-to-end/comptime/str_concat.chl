#include <stdio.h>

comptime const _str& prefix = "a\0b";

comptime const _str& suffix(bool long_form) {
    if (long_form) return "cd\0";
    return "c";
}

comptime bool unsized = @type.equal(@type.type_of(@str.concat("a", "b")), _str&);

int main() {
    const char* joined = @str.concat(prefix, @str.concat(suffix(true), "e"));
    const char* empty = @str.concat("", "");
    printf("%d %c%d%c%c%c%d%c %d %d\n", unsized, joined[0], joined[1], joined[2],
        joined[3], joined[4], joined[5], joined[6], joined[7], empty[0]);
    return 0;
}
