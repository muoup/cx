/* CX-STDOUT: value 41 calls 1 */

#include <stdio.h>

import std::optional as std;

int calls;

std::opt(int) make_value() {
    calls += 1;
    return std::opt(int)::some(41);
}

int main() {
    int value = make_value() |>(1) std::opt::unwrap_or_else(_, emit .{
        printf("unexpected none\n");
        return 1;
    });

    printf("value %d calls %d\n", value, calls);
}
