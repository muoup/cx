/* CX-STDOUT: initialized none */
/* CX-STDOUT-NEXT: returned none */

#include <stdio.h>

import std::optional as std;

std::opt(int) make_none() {
    return _::none();
}

void print_result(const char* label, std::opt(int) value) {
    match (value) {
        some(auto inner) => printf("%s some %d\n", label, inner);
        none() => printf("%s none\n", label);
    }
}

int main() {
    std::opt(int) initialized = _::none();

    print_result("initialized", initialized);
    print_result("returned", make_none());
}
