/* CHL-STDOUT: alpha */
/* CHL-STDOUT-NEXT: beta */
/* CHL-STDOUT-NEXT: line bytes: 6 */

import std::{io::file, memory::allocation, optional, string} as std;

#include <stdio.h>

i32 main() {
    auto file = std::file::open("end-to-end/library/file_read_to_string.txt", "r") |> std::opt::unwrap();
    defer std::file::close(move file);

    char first_line[16];
    usize length = std::file::read_line(file, first_line, sizeof(first_line)) |> std::opt::unwrap();
    printf("%s", first_line);

    auto tail = std::file::read_to_string(.A = std::aligned_heap_allocator, file);
    printf("%s", std::string::as_str(tail));
    std::string::drop(move tail);

    printf("line bytes: %zu\n", length);
    return 0;
}
