/* CHL-STDOUT: socket checks passed */

import std::{collections::span, net::{address, error, tcp, udp}, optional, result, collections::string, panic} as std;
import std::platform::posix::{error, socket} as std::posix;
import std::platform::posix as std::posix::raw;

#include <errno.h>
#include <stdio.h>

void check(bool passed) {
    if (!passed) std::panic("Socket invariant failed");
}

void socket_errors() {
    check(std::posix::fd_result::is_ok((std::posix::raw::fd_result) 0));
    check(!std::posix::fd_result::is_ok((std::posix::raw::fd_result) -1));
    auto closed = std::posix::socket::close(std::posix::socket::new(-1));
    auto code = std::posix::errno_code::current();
    check(code == (std::posix::raw::errno_code) std::posix::raw::errno_type::BADF);

    errno = (int) std::posix::raw::errno_type::AGAIN;
    auto would_block = std::posix::errno_code::into_socket_error(std::posix::errno_code::current());
    check(std::socket_error::is_would_block(would_block));
    check(closed is err(auto error) && !std::socket_error::is_would_block(error));
}

void tcp(std::endpoint address) {
    auto server = std::tcp_server::new() |> std::result::unwrap();
    defer std::tcp_server::drop(move server);
    std::tcp_server::bind(server, address) |> std::result::unwrap();
    std::tcp_server::set_blocking(server, false) |> std::result::unwrap();

    match (std::tcp_server::accept(server)) {
        ok(auto connection) => .{
            std::tcp_connection::drop(move connection);
            std::panic("Accepted an unexpected connection");
        },
        err(auto error) => .{
            check(std::socket_error::is_would_block(error));
            u8 output[128];
            check(std::socket_error::format(error, std::span::new(output, sizeof(output))) > 0);
        }
    }

    auto local = std::tcp_server::local_address(server) |> std::result::unwrap();
    auto client = std::tcp_connection::connect_to(local) |> std::result::unwrap();
    auto accepted = std::tcp_server::accept(server) |> std::result::unwrap();
    defer std::tcp_connection::drop(move accepted);
    check(std::tcp_connection::remote(client).port == local.port);
    check(!std::posix::posix_status::is_ok(std::posix::raw::close(-1)) && errno == EBADF);
    std::tcp_connection::send(client, std::str::as_const_bytes("x")) |> std::result::unwrap();
    std::tcp_connection::drop(move client);

    u8 buffer[16];
    check(!std::posix::posix_status::is_ok(std::posix::raw::close(-1)) && errno == EBADF);
    auto received = std::tcp_connection::read(accepted, std::span::new(buffer, sizeof(buffer)))
        |> std::result::unwrap();
    check(received.length == 1 && received.data[0] == 'x');
    auto eof = std::tcp_connection::read(accepted, std::span::new(buffer, sizeof(buffer)))
        |> std::result::unwrap();
    check(eof.length == 0);
}

void udp(std::endpoint address) {
    auto receiver = std::udp_socket::open() |> std::result::unwrap();
    defer std::udp_socket::close(move receiver);
    auto sender = std::udp_socket::open() |> std::result::unwrap();
    defer std::udp_socket::close(move sender);
    std::udp_socket::bind(receiver, address) |> std::result::unwrap();
    std::udp_socket::set_blocking(receiver, false) |> std::result::unwrap();
    auto local = std::udp_socket::local_address(receiver) |> std::result::unwrap();

    usize sent = std::udp_socket::send_to(sender, std::str::as_const_bytes(""), local) |> std::result::unwrap();
    check(sent == 0);
    u8 buffer[16];
    auto datagram = std::udp_socket::recv_from(receiver, std::span::new(buffer, sizeof(buffer)))
        |> std::result::unwrap();
    check(datagram.length == 0 && datagram.source.address == address.address);
}

int main() {
    socket_errors();
    auto socket = std::posix::socket::open(std::posix::stream_socket) |> std::result::unwrap();
    int native_type = 0;
    std::posix::raw::socklen_t length = sizeof(native_type);
    auto status = std::posix::raw::getsockopt(
        socket.fd, std::posix::raw::socket_option_level::SOCKET, std::posix::raw::socket_option::TYPE,
        &native_type, &length
    );
    check(std::posix::posix_status::is_ok(status) && native_type == (int) std::posix::raw::socket_type::STREAM);
    std::posix::socket::close(move socket) |> std::result::unwrap();
    auto address = std::endpoint::ipv4("127.0.0.1", 0) |> std::opt::unwrap();
    check(std::endpoint::ipv4("255.255.255.255", 0) is some(_));
    check(std::endpoint::ipv4("256.0.0.1", 0) is none());
    tcp(address);
    udp(address);
    puts("socket checks passed");
    return 0;
}
