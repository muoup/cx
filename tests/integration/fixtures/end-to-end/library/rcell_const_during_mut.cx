/* CX-STDOUT: mutable active 8 */
/* CX-STDOUT-NEXT: PANIC: Cannot immutably borrow cell while it is currently mutably borrowed */

import std::cell::rcell as std;
import std::io as std;

int main() {
    std::rcell(int) cell = std::rcell::new(_, 8);
    std::rcell::borrow(_, emit cell) <| |mutable| then

    std::printf("mutable active %d\n", mutable);
    std::rcell::borrow_const(_, emit cell) <| |value| emit .{
        std::printf("unreachable const %d\n", value);
    };
    std::printf("unreachable end\n");
    return 0;
}
