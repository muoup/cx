/* CHL-STDOUT: dropped num: 1 */

import std::memory::box;

#include <stdio.h>

struct test_type : @nodrop {
    int num;
};

void destructor(test_type t) {
    printf("dropped num: %d\n", t.num);
    @leak(t);
}

int main() {
    std::memory::box::box(test_type) t = std::memory::box::box::new((test_type) { .num = 1 });
    move t |> std::memory::box::box::drop_with(destructor);
}
