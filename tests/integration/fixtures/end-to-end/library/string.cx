/* CX-STDOUT: Hello, world! */

import std::string as std;
import std::optional as std;

#include <stdio.h>

int main() {
    std::string::string s = std::string::string::new();
    s |> std::string::append_str("Hello, worl");
    s |> std::string::append_char('d');
    s |> std::string::append_char('!');
    printf("%s\n", s.data);
    move s |> std::string::string::drop();
}
