/* CX-STDOUT: tapped 5 */
/* CX-STDOUT-NEXT: inspected 5 */

#include <stdio.h>

import std::functional as std;

int main() {
    int tapped = 4 |> std::tap<int, void>(|value| .{
        value += 1;
    });
    printf("tapped %d\n", tapped);

    int observed = 0;
    int inspected = move tapped |> std::inspect<int, void>(|value| .{
        observed = value;
    });
    printf("inspected %d\n", observed);
    return inspected - 5;
}
