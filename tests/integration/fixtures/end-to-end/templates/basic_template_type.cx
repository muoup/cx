/* CX-STDOUT: data: 42 */

#include <stdio.h>

comptime @type Ptr(@type T) => T*;

comptime @type Data(@type T) =>
    struct {
        Ptr(T) ptr;
    };

void access(Data(int) *data) {
    *data.ptr = 42;
}

int main() {
    int val;
    Data(int) data = {
        .ptr = &val
    };

    access(&data);
    printf("data: %d\n", *data.ptr); //Output: data: 42
}
