/* CX-STDOUT: a.i: 42 */
/* CX-STDOUT-NEXT: b.i: 43 */

import std::io as std;

comptime @type test(@type T) =>
    struct {
        T i;
    };

test(U) test::map(@type T, @type U, test(T)& this, U (*func)(T)) {
    return (test(U)) { .i = func(this.i) };
}

float add_one(int x) {
    return (float)(x + 1);
}

int main() {
    test(int) a = (test(int)) { .i = 42 };
    test(float) b = a |>(2) test::map(int, float, add_one);
    
    std::printf("a.i: %d\n", a.i);
    std::printf("b.i: %.0f\n", b.i);
}
