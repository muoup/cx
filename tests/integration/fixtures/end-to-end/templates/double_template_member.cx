/* CX-STDOUT: a.i: 42 */
/* CX-STDOUT-NEXT: b.i: 43 */

import std::io as std;

struct test<T> {
    T i;
};

test<U> test::map<T, U>(test<T>& this, U (*func)(T)) {
    return (test<U>) { .i = func(this.i) };
}

float add_one(int x) {
    return (float)(x + 1);
}

int main() {
    test<int> a = (test<int>) { .i = 42 };
    test<float> b = a |> test::map<int, float>(add_one);
    
    std::printf("a.i: %d\n", a.i);
    std::printf("b.i: %.0f\n", b.i);
}
