import std::io as std;
import std::optional as std;
import std::net::udp as std::net;

std::opt<std::socket> try_serve(u16 port) {
    std::net::endpoint endpoint = std::net::endpoint::ipv4("0.0.0.0", port);

    std::net::udp_socket socket = std::net::udp_socket::open(std::socket::AF_INET, std::socket::SOCK_STREAM, 0);

    if (socket |> std::net::udp_socket::bind(&addr) < 0) {
        return std::opt::none<std::socket>();
    }

    if (listener |> std::net::udp_socket::listen(128) < 0) {
        return std::opt::none<std::socket>();
    }

    return move listener |> std::opt::some<std::socket>();
}
