struct Resource : @nodrop {
    int data;
};

struct Container : @nodrop {
    Resource resource;
    int count;
};

void Resource::drop(Resource this) safe {
    @unsafe {
        @leak(this);
    };
}

void Container::drop(Container this) safe {
    @unpack(move this) {
        resource: resource,
    };

    move resource |> Resource::drop();
}

int main() {
    Container container = (Container) {
        .resource = (Resource) {
            .data = 1
        },
        .count = 2
    };

    move container |> Container::drop();
    return 0;
}
