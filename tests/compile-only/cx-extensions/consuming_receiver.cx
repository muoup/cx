struct Resource : @nodrop {
    int data;
};

Resource make_resource() {
    return (Resource) {
        .data = 0
    };
}

void Resource::drop(Resource this) safe {
    @unsafe {
        @leak(this);
    };
}

int main() {
    Resource value = make_resource();
    move value |> Resource::drop();
    make_resource() |> Resource::drop;
    return 0;
}
