struct Data : @nocopy {
    int value;
};

void consume(Data data) {
    @leak(data);
}

int good(int cond) {
    Data data = (Data) {
        .value = 1
    };

    if (cond) {
        consume(move data);
        return 0;
        int impossible = data.value;
    }

    consume(move data);
    return 1;
}

int main() {
    return good(0);
}
